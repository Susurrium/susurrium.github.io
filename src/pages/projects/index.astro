---
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import alipay from '@/assets/alipay-qrcode.jpg'
import KeyIcon from '@/assets/icons/key.svg'
import wechat from '@/assets/wechat-qrcode.jpg'

const headings = [
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'learnings', text: 'Course notes' },
  { depth: 2, slug: 'gpg-signature', text: 'GPG key' },
  { depth: 2, slug: 'sponsorship', text: 'Support' }
]
---

<PageLayout
  title='Projects'
  description='Selected projects, course notes, and ways to support my work.'
  {headings}
  view
>
  <p>如果您认为我的工作有用或有趣，可以通过赞赏支持我，也可以联系我讨论项目。</p>
  <Button title='Support my work' class='w-fit' href='#sponsorship'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button>

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: 'PkuHoleStudio',
        description:
          '本地优先的北大树洞客户端，支持在线浏览、本地资料库、全文搜索、归档迁移与可选 AI 研究。',
        links: [
          { type: 'github', href: 'https://github.com/Susurrium/PkuHoleStudio' },
          { type: 'release', href: 'https://github.com/Susurrium/PkuHoleStudio/releases/latest' },
          {
            type: 'doc',
            href: 'https://github.com/Susurrium/PkuHoleStudio/blob/main/docs/technical-reference.md'
          }
        ]
      },
      {
        name: 'PkuHoleToolkit',
        description: '运行在树洞官网中的用户脚本，用于本地备份、ZIP 导出和换号迁移。',
        links: [
          { type: 'github', href: 'https://github.com/Susurrium/PkuHoleToolkit' },
          { type: 'release', href: 'https://github.com/Susurrium/PkuHoleToolkit/releases/latest' },
          {
            type: 'doc',
            href: 'https://github.com/Susurrium/PkuHoleToolkit/blob/main/BETA_TEST_CHECKLIST.md'
          }
        ]
      },
      {
        name: 'Signature Generator',
        description: '在浏览器中记录签名笔顺与墨迹区域，预览并导出黑色或渐变动态 SVG。',
        links: [
          { type: 'site', href: 'https://susurrium.github.io/signature-generator/' },
          { type: 'github', href: 'https://github.com/Susurrium/signature-generator' }
        ]
      }
    ]}
  />

  <h2 id='learnings'>Course notes</h2>
  <ProjectSection class='my-2' projects={[]} emptyText='暂无公开课程笔记。' />

  <!-- gpg signature -->
  <h2 id='gpg-signature'>GPG key</h2>
  <p>
    你可以通过验证 GPG 签名，确认我发布的文件确实由我签署，且自签署以来未被篡改。<br />
    我的公钥指纹为 <code>FB3EC3ABA5571B1A467D232CC97D43D99DACF945</code>。
  </p>
  <Button
    href='https://keys.openpgp.org/search?q=FB3EC3ABA5571B1A467D232CC97D43D99DACF945'
    title='View public key'
  >
    <KeyIcon class='size-5' slot='before' />
  </Button>

  <!-- sponsorship -->
  <h2 id='sponsorship'>Support</h2>
  <p>感谢您的支持，这是我继续维护这些项目的重要动力。</p>
  <Sponsorship
    methods={[
      { name: 'WeChat', icon: 'wechat-pay', image: wechat },
      { name: 'Alipay', icon: 'alipay', image: alipay }
    ]}
  />
  <!-- <p>Thanks to the following sponsors:</p>
  <Sponsors
    sponsors={[
      { name: 'C*a（酷安@暴走の蜗牛）', amount: '2.00', date: '2019-07-02' },
      { name: '华雄(QQ：1300****71)', amount: '5.00', date: '2019-12-30' },
      { name: '◌(QQ：1934****45)', amount: '3.00', date: '2019-12-30' },
      { name: 'Anonymous', amount: '20.00', date: '2022-04-06' }
    ]}
  /> -->
</PageLayout>
