---
import { getCollection } from 'astro:content'
import { Button } from 'astro-pure/user'
import ContentCard from '@/components/cards/ContentCard.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import { published, sortByDate } from '@/lib/content'

const traces = sortByDate(published(await getCollection('trace')))
const meta = {
  description: 'Short notes, fragments, and observations that are still growing.',
  title: 'Traces'
}
---

<PageLayout {meta}>
  <Button title='Back' href='/home' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <p class='text-sm text-muted-foreground'>Short notes and evolving observations</p>
      <h1 class='mb-6 mt-3 text-3xl font-medium sm:mt-4'>Traces</h1>
    </div>

    {
      traces.length === 0 ? (
        <p id='content' class='animate text-muted-foreground'>No published traces yet.</p>
      ) : (
        <div id='content' class='animate -mx-4 flex flex-col' aria-label='Trace list' data-traces-list>
          {
            traces.map((trace, index) => (
              <ContentCard contentKind='trace' entry={trace} headingLevel={2} {index} />
            ))
          }
        </div>
      )
    }
  </main>
</PageLayout>
