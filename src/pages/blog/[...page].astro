---
import type { GetStaticPaths, Page } from 'astro'
import {
  buildCollectionStaticPaths,
  contentTagHref,
  hydratePageItems,
  loadContentCatalog,
  sortContentRecords,
  toPaginatorProps,
  type PageItem
} from '@/lib/content-layer'

import { Paginator } from 'astro-pure/components/pages'
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ContentCard from '@/components/cards/ContentCard.astro'
import { contentPagination } from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const contentCatalog = await loadContentCatalog()
  const collections = sortContentRecords(contentCatalog.byKind.blog, 'editorial-date-desc')
  const uniqueTags = [...new Set(collections.flatMap((record) => record.tags))]
  const collectionsCount = collections.length
  return buildCollectionStaticPaths(contentCatalog, 'blog', paginate, {
    itemOptions: { detailed: true },
    pagination: contentPagination.blog,
    props: { collectionsCount, uniqueTags }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<PageItem>
  uniqueTags: string[]
  collectionsCount: number
}

const { page, uniqueTags, collectionsCount } = Astro.props
const contentCatalog = await loadContentCatalog()
const renderItems = hydratePageItems(page.data, contentCatalog)

const meta = {
  description: 'Browse all posts.',
  title: page.currentPage > 1 ? `Blog · Page ${page.currentPage}` : 'Blog'
}

const paginationProps = toPaginatorProps(page)
---

<PageLayout {meta}>
  <Button title='Back' href='/home' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 id='blog-heading' class='mb-6 mt-6 text-3xl font-medium sm:mt-10'>Blog</h1>
    </div>
    <div class='grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
      <section aria-labelledby='blog-heading' class='animate' id='content'>
        {
          page.data.length === 0 ? (
            <p class='site-empty-state'>No posts yet.</p>
          ) : (
            <>
              {/* header */}
              <div class='mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row'>
                <span class='text-muted-foreground'>
                  Page {page.currentPage} - Showing {page.data.length} of {collectionsCount} posts
                </span>
                <a aria-label='Browse archives by year' href='/archives' data-astro-prefetch>
                  Browse archives by year →
                </a>
              </div>
              {/* posts */}
              <ul class='flex flex-col gap-y-4 text-start'>
                {renderItems.map((item) => (
                  <ContentCard item={item} />
                ))}
              </ul>
              <Paginator {...paginationProps} />
            </>
          )
        }
      </section>

      {/* Keep the Blog taxonomy discoverable even while the collection is empty. */}
      <aside
        class='animate'
        id='sidebar'
        aria-label='Blog taxonomy'
        data-taxonomy-navigation
        data-taxonomy-scope='blog'
        data-taxonomy-count={uniqueTags.length}
      >
        <h2 class='mb-4 flex items-center text-lg font-semibold'>
          <Icon name='tag-2' class='me-2' />
          Tags
        </h2>
        {uniqueTags.length > 0 ? (
          <ul class='text-bgColor flex flex-wrap gap-2'>
            {uniqueTags.map((tag) => (
              <li>
                <Button title={tag} href={contentTagHref('blog', tag)} variant='pill' />
              </li>
            ))}
          </ul>
        ) : (
          <p class='text-muted-foreground' data-taxonomy-empty>No blog tags yet.</p>
        )}
        <span class='mt-4 block sm:text-end'>
          <Button
            title='View all'
            aria-label='View all tags'
            href='/blog/tags'
            variant='ahead'
            class='not-prose'
            data-taxonomy-action='ahead'
          />
        </span>
      </aside>
    </div>
  </main>
</PageLayout>
