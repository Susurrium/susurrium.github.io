---
import links from 'public/links.json'
import config from 'virtual:config'

import { Collapse, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Signature from '@/components/shared/Signature.astro'
import FriendList from '@/components/links/FriendList.astro'
import { siteFeatures } from '@/site-config'

const headings = [
  { depth: 2, slug: 'common-links', text: 'Common Links' },
  { depth: 2, slug: 'special-links', text: 'Special Links' },
  { depth: 2, slug: 'apply-links', text: 'Link exchange' }
]

const { friends } = links
const linksConf = config.integ.links
---

<PageLayout title='Links' {headings} comment effectProfile='links'>
  <h2 id='common-links'>Common Links</h2>
  <FriendList list={friends[0]} />
  <Collapse title='Links with Bad Status'>
    <FriendList list={friends[1]} />
  </Collapse>
  <Collapse title='Link history'>
    <Timeline events={linksConf.logbook} />
  </Collapse>
  <h2 id='special-links'>Special Links</h2>
  <FriendList list={friends[2]} />

  <!-- apply-links -->
  <h2 id='apply-links'>Link exchange</h2>
  <p>本站信息（点击复制）：</p>
  <blockquote class='not-prose border-s-4 ps-4'>
    <site-info-copy class='grid grid-cols-[auto_1fr] gap-x-2 break-words'>
      {
        linksConf.applyTip.map(({ name, val }) => (
          <>
            <span class='text-end'>{name}:</span>
            <button
              class='site-info-copy__value focus-ring'
              type='button'
              data-copy-value={val}
              aria-label={`Copy ${name}`}
              title='Copy'
            >
              {val}
            </button>
          </>
        ))
      }
    </site-info-copy>
  </blockquote>

  <p>申请时请按此模板留言，并确认：</p>
  <ul>
    <li>已在你的友链上添加本站。</li>
    <li>请确保你的站点正常运行。</li>
    <li>博客内容不违反适用法律。</li>
  </ul>
  {siteFeatures.signature.enabled && <Signature />}
</PageLayout>

<script>
  class SiteInfoCopy extends HTMLElement {
    #controller?: AbortController

    connectedCallback() {
      this.#controller?.abort()
      this.#controller = new AbortController()
      this.addEventListener('click', this.#handleClick, { signal: this.#controller.signal })
    }

    disconnectedCallback() {
      this.#controller?.abort()
      this.#controller = undefined
    }

    #handleClick = (event: MouseEvent) => {
      const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(
        '[data-copy-value]'
      )
      if (!button || !this.contains(button)) return

      const value = button.dataset.copyValue ?? ''
      void this.#copy(value)
    }

    async #copy(value: string) {
      let copied = false

      try {
        await navigator.clipboard.writeText(value)
        copied = true
      } catch {
        const input = document.createElement('textarea')
        input.value = value
        input.setAttribute('aria-hidden', 'true')
        input.style.cssText = 'position:fixed;opacity:0;pointer-events:none'
        document.body.append(input)
        try {
          input.select()
          // `execCommand` is the last-resort path for older browsers. Read it
          // reflectively so the supported Clipboard API remains the primary
          // contract without introducing a deprecated DOM typing diagnostic.
          const execCommand = Reflect.get(document, 'execCommand') as
            | ((commandId: string) => boolean)
            | undefined
          copied = typeof execCommand === 'function' ? execCommand.call(document, 'copy') : false
        } catch {
          copied = false
        } finally {
          input.remove()
        }
      }

      document.dispatchEvent(
        new CustomEvent('toast', {
          detail: {
            message: copied
              ? 'Copied to clipboard.'
              : 'Copy failed. Please copy it manually.'
          }
        })
      )
    }
  }

  if (!customElements.get('site-info-copy')) {
    customElements.define('site-info-copy', SiteInfoCopy)
  }
</script>

<style>
  .site-info-copy__value {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
    text-align: left;
  }

  .site-info-copy__value:hover {
    color: hsl(var(--primary));
  }
</style>
