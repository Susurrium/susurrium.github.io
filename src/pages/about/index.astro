---
import { educationEntries, toProfileTimelineEntry } from '@/data/education'
import { experienceEntries } from '@/data/experience'
import { profileIntro } from '@/data/profile'

import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import AboutTimeline from '@/components/about/AboutTimeline.astro'
import ToolSection from '@/components/about/ToolSection.astro'
import CodeTimeCard from '@/components/CodeTimeCard.astro'
import ConnectCards from '@/components/ConnectCards.astro'
import zotero from '@/assets/tools/zotero.png'

const educationTimelineEntries = educationEntries.map(toProfileTimelineEntry)

const headings = [
  {
    depth: 2,
    slug: 'tools',
    text: 'Tools'
  },
  {
    depth: 2,
    slug: 'connect',
    text: 'Connect'
  },
  {
    depth: 2,
    slug: 'education',
    text: 'Education'
  },
  {
    depth: 2,
    slug: 'experience',
    text: 'Experience'
  },
  {
    depth: 2,
    slug: 'sayings',
    text: 'Sayings'
  },
  {
    depth: 2,
    slug: 'about-this-site',
    text: 'About this site'
  }
]
---

<PageLayout
  title='About'
  description='A personal profile, tools, experience, and selected notes.'
  {headings}
  comment
  effectProfile='about'
>
  <CodeTimeCard />

  <h2 id='general-talk' class='invisible m-0 h-0'>General Talk</h2>
  <p class='text-muted-foreground' set:html={profileIntro.role}></p>
  {profileIntro.paragraphs.map((paragraph) => <p set:html={paragraph}></p>)}

  {/* tools */}
  <h2 id='tools'>Tools</h2>
  <p>以下是我正在使用的一些工具：</p>
  <ToolSection
    class='mb-5'
    title='Productivity'
    tools={[
      {
        name: 'Obsidian',
        description: 'Knowledge management',
        href: 'https://obsidian.md/',
        icon: import('@/assets/tools/obsidian.svg?raw')
      },
      {
        name: 'Zotero',
        description: 'Reference management',
        href: 'https://www.zotero.org/',
        icon: zotero
      },
      {
        name: 'Typora',
        description: 'Markdown editor',
        href: 'https://typora.io/',
        icon: import('@/assets/tools/typora.svg?raw')
      },
      {
        name: 'NotebookLM',
        description: 'Source-grounded note-taking',
        href: 'https://notebooklm.google.com/',
        icon: import('@/assets/tools/notebooklm.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'Codex',
        description: 'AI coding agent',
        href: 'https://openai.com/codex/',
        icon: import('@/assets/tools/codex.svg?raw')
      },
      {
        name: 'VS Code',
        description: 'Code editor',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      },
      {
        name: 'Claude Code',
        description: 'Terminal coding agent',
        href: 'https://www.anthropic.com/claude-code',
        icon: import('@/assets/tools/claude-code.svg?raw')
      },
      {
        name: 'Cursor',
        description: 'AI code editor',
        href: 'https://www.cursor.com/',
        icon: import('@/assets/tools/cursor.svg?raw'),
        darkIcon: import('@/assets/tools/cursor_dark.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Design'
    tools={[
      {
        name: 'Photoshop',
        description: 'Image editor',
        href: 'https://www.adobe.com/products/photoshop',
        icon: import('@/assets/tools/photoshop.svg?raw')
      },
      {
        name: 'Blender',
        description: '3D creation suite',
        href: 'https://www.blender.org/',
        icon: import('@/assets/tools/blender.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Environment'
    tools={[
      {
        name: 'Windows 11',
        description: 'Desktop operating system',
        href: 'https://www.microsoft.com/windows/windows-11',
        icon: import('@/assets/tools/windows11.svg?raw')
      },
      {
        name: 'Ubuntu 24.04 LTS',
        description: 'Linux distribution',
        href: 'https://ubuntu.com/',
        icon: import('@/assets/tools/ubuntu.svg?raw')
      },
      {
        name: 'WSL 2',
        description: 'Linux subsystem',
        href: 'https://learn.microsoft.com/windows/wsl/',
        icon: import('@/assets/tools/wsl.svg?raw')
      },
      {
        name: 'Tailscale',
        description: 'Mesh VPN',
        href: 'https://tailscale.com/',
        icon: import('@/assets/tools/tailscale.svg?raw')
      }
    ]}
  />

  {/* connect */}
  <!-- Keep the old fragment target without surfacing the retired section name. -->
  <span id='social-networks' class='sr-only' aria-hidden='true'></span>
  <h2 id='connect'>Connect</h2>
  <p>你可以在这里找到我、联系我，或订阅更新：</p>
  <ConnectCards />

  <h2 id='education'>Education</h2>
  <AboutTimeline entries={educationTimelineEntries} emptyText='暂无教育经历记录。' />

  <h2 id='experience'>Experience</h2>
  <AboutTimeline entries={experienceEntries} emptyText='暂未整理可公开的经历。' />

  <h2 id='sayings'>Sayings</h2>
  <p>
    这里收藏一些我愿意反复重读的句子。它们来自不同的声音，却在某些时刻，替我说出了难以言明的部分
    <br />
    “虽世殊事异，所以兴怀，其致一也”
  </p>
  <Button
    title='View all'
    href='/sayings'
    variant='ahead'
    aria-label='View all Sayings'
    class='not-prose'
    data-about-action='ahead'
  />

  {/* about-this-site */}
  <span id='about-blog' class='sr-only' aria-hidden='true'></span>
  <h2 id='about-this-site'>About this site</h2>
  <p>本站基于以下项目/服务提供商的资源和技术支持，感谢各维护者的工作。</p>
  <ul>
    <li>
      框架：<a href='https://astro.build/' target='_blank' rel='noopener noreferrer'>Astro</a>
    </li>
    <li>
      主题：<a
        href='https://github.com/cworld1/astro-theme-pure'
        target='_blank'
        rel='noopener noreferrer'>Astro Theme Pure</a
      >
    </li>
    <li>
      部署：<a href='https://pages.github.com/' target='_blank' rel='noopener noreferrer'
        >GitHub Pages</a
      >
    </li>
    <li>
      浏览量：<a href='https://waline.js.org/' target='_blank' rel='noopener noreferrer'
        >Waline</a
      > + <a href='https://vercel.com/' target='_blank' rel='noopener noreferrer'>Vercel</a>
    </li>
    <li>
      访问统计：<a href='https://umami.is/' target='_blank' rel='noopener noreferrer'>Umami Cloud</a>
    </li>
    <li>
      地图：<a
        href='https://www.openstreetmap.org/copyright'
        target='_blank'
        rel='noopener noreferrer'>OpenStreetMap</a
      > + <a href='https://carto.com/' target='_blank' rel='noopener noreferrer'>CARTO</a>
    </li>
  </ul>
</PageLayout>
