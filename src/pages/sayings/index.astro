---
import { getCollection } from 'astro:content'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { formatContentDate, published, sortByDate } from '@/lib/content'

const sayings = sortByDate(published(await getCollection('saying')))
const meta = {
  description: 'A small archive of collected sayings, their sources, and future personal notes.',
  title: 'Sayings'
}
---

<PageLayout {meta}>
  <Button title='Back' href='/home' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <p class='text-sm text-muted-foreground'>A collected archive, not a main-nav content type</p>
      <h1 class='mb-6 mt-3 text-3xl font-medium sm:mt-4'>Sayings</h1>
    </div>

    {
      sayings.length === 0 ? (
        <p id='content' class='animate text-muted-foreground'>No published sayings yet.</p>
      ) : (
        <ul id='content' class='animate grid gap-4 md:grid-cols-2' aria-label='Saying archive'>
          {
            sayings.map((saying) => (
              <li class='rounded-2xl border bg-background transition-colors hover:bg-muted hover:text-primary'>
                <a
                  class='block h-full px-5 py-5 sm:px-6'
                  href={`/sayings/${saying.id}`}
                  data-astro-prefetch
                >
                  <blockquote class='text-lg font-medium leading-8'>
                    <q>{saying.data.text}</q>
                  </blockquote>
                  <div class='mt-5 flex items-end justify-between gap-x-4 text-xs text-muted-foreground'>
                    <span>
                      {saying.data.author ?? 'Unknown'} · {formatContentDate(saying.data.publishDate)}
                    </span>
                    <span aria-hidden='true' class='shrink-0'>→</span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      )
    }
  </main>
</PageLayout>
