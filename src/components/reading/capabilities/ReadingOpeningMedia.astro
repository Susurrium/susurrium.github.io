---
/**
 * The opening-media capability used by reading headers.
 *
 * `layered-blur` reuses the reference site's main-image + blurred duplicate
 * composition without assigning it to one content type. `standard` remains
 * the source-agnostic single-image option.
 */
import { Image } from 'astro:assets'
import type { ReadingOpeningMediaData } from '@/lib/content-layer/reading-data'
import {
  isReadingFeatureVisible,
  type ReadingMediaVariant,
  type ReadingOpeningMediaBackdropConfig
} from '@/lib/content-layer/reading-policy'

import ReadingOpeningMediaBackdrop from './ReadingOpeningMediaBackdrop.astro'

interface Props {
  backdrop?: ReadingOpeningMediaBackdropConfig
  data: ReadingOpeningMediaData
  variant?: ReadingMediaVariant
}

const { backdrop, data, variant = 'standard' } = Astro.props as Props
const imageMetadata = typeof data.source === 'string' ? undefined : data.source
const backdropMode = backdrop?.mode ?? (variant === 'layered-blur' ? 'on' : 'off')
const backdropVariant = backdrop?.variant ?? 'projected-blur'
const showBackdrop =
  (backdropVariant === 'blur' || backdropVariant === 'projected-blur') &&
  isReadingFeatureVisible(backdropMode, Boolean(data.source))
const useLayeredMedia = variant === 'layered-blur' || showBackdrop
const imageClass =
  'cover-image reading-opening-media__image relative z-10 h-auto w-full max-w-[65ch] rounded-2xl object-contain'
---

{
  useLayeredMedia ? (
    // The wrapper is a short projection rail: the cover keeps its 65ch cap and
    // the duplicate gets a deliberate 3rem lower-right runway. Capping the
    // rail prevents no-TOC article columns from turning the duplicate into a
    // wide, detached panel while retaining the reference composition.
    <div
      class='hero-image reading-opening-media reading-opening-media--layered relative mb-6 w-full max-w-[calc(65ch+3rem)]'
      data-reading-opening-media
      data-reading-opening-media-layered
      data-reading-opening-media-variant={variant}
      data-reading-opening-media-backdrop-variant={showBackdrop ? backdropVariant : undefined}
      data-reading-opening-backdrop-root={showBackdrop ? '' : undefined}
    >
      {imageMetadata ? (
        <Image
          alt={data.alt}
          class={imageClass}
          data-reading-opening-media-image
          fetchpriority='high'
          loading='eager'
          src={imageMetadata}
        />
      ) : (
        <img
          alt={data.alt}
          class={imageClass}
          data-reading-opening-media-image
          fetchpriority='high'
          loading='eager'
          src={data.src}
        />
      )}
      {showBackdrop && (
        <ReadingOpeningMediaBackdrop
          source={data.source}
          src={data.src}
          variant={backdropVariant}
        />
      )}
    </div>
  ) : (
    <figure
      class='reading-opening-media relative mb-6 w-full max-w-[65ch]'
      data-reading-opening-media
      data-reading-opening-media-variant={variant}
    >
      {imageMetadata ? (
        <Image
          alt={data.alt}
          class={imageClass}
          data-reading-opening-media-image
          fetchpriority='high'
          loading='eager'
          src={imageMetadata}
        />
      ) : (
        <img
          alt={data.alt}
          class={imageClass}
          data-reading-opening-media-image
          fetchpriority='high'
          loading='eager'
          src={data.src}
        />
      )}
    </figure>
  )
}
