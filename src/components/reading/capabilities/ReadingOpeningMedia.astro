---
/**
 * The opening-media capability used by reading headers.
 *
 * `layered-blur` preserves the established main-image + blurred-backdrop
 * visual without assigning it to one content type. `standard` remains the
 * source-agnostic single-image option.
 */
import { Image } from 'astro:assets'
import type { ReadingOpeningMediaData } from '@/lib/content-layer/reading-data'
import {
  isReadingFeatureVisible,
  type ReadingMediaVariant,
  type ReadingOpeningMediaBackdropConfig
} from '@/lib/content-layer/reading-policy'

import ReadingOpeningMediaBackdrop from './ReadingOpeningMediaBackdrop.astro'

interface Props {
  backdrop?: ReadingOpeningMediaBackdropConfig
  data: ReadingOpeningMediaData
  variant?: ReadingMediaVariant
}

const { backdrop, data, variant = 'standard' } = Astro.props as Props
const imageMetadata = typeof data.source === 'string' ? undefined : data.source
const backdropMode = backdrop?.mode ?? (variant === 'layered-blur' ? 'on' : 'off')
const backdropVariant = backdrop?.variant ?? 'blur'
const showBackdrop =
  backdropVariant === 'blur' && isReadingFeatureVisible(backdropMode, Boolean(data.source))
const useLayeredMedia = variant === 'layered-blur' || showBackdrop
const imageClass =
  'cover-image reading-opening-media__image relative z-10 block h-auto w-full rounded-2xl object-contain'
---

{
  useLayeredMedia ? (
    <div
      class:list={[
        'hero-image reading-opening-media reading-opening-media--layered relative w-full max-w-[65ch]',
        showBackdrop ? 'reading-opening-media--with-backdrop' : 'mb-6'
      ]}
      data-reading-opening-media
      data-reading-opening-media-layered
      data-reading-opening-media-variant={variant}
      data-reading-opening-backdrop-root={showBackdrop ? '' : undefined}
    >
      {imageMetadata ? (
        <Image
          alt={data.alt}
          class={imageClass}
          data-reading-opening-media-image
          fetchpriority='high'
          loading='eager'
          src={imageMetadata}
        />
      ) : (
        <img
          alt={data.alt}
          class={imageClass}
          data-reading-opening-media-image
          fetchpriority='high'
          loading='eager'
          src={data.src}
        />
      )}
      {showBackdrop && <ReadingOpeningMediaBackdrop source={data.source} src={data.src} />}
    </div>
  ) : (
    <figure
      class='reading-opening-media relative mb-6 w-full max-w-[65ch]'
      data-reading-opening-media
      data-reading-opening-media-variant={variant}
    >
      {imageMetadata ? (
        <Image
          alt={data.alt}
          class={imageClass}
          data-reading-opening-media-image
          fetchpriority='high'
          loading='eager'
          src={imageMetadata}
        />
      ) : (
        <img
          alt={data.alt}
          class={imageClass}
          data-reading-opening-media-image
          fetchpriority='high'
          loading='eager'
          src={data.src}
        />
      )}
    </figure>
  )
}

<style>
  /*
   * The backdrop is intentionally positioned out of flow. Reserve only the
   * small amount of visual bleed that remains below it so the metadata row
   * never sits on top of the ambient layer.
   */
  .reading-opening-media--with-backdrop {
    margin-bottom: calc(1.5rem + 0.75rem);
  }

  @media (max-width: 639px) {
    .reading-opening-media--with-backdrop {
      margin-bottom: calc(1.5rem + 0.5rem);
    }
  }
</style>
