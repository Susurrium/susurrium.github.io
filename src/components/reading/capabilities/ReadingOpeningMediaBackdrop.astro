---
/**
 * Optional backdrop attached to opening media. The projected mode intentionally
 * follows Astro Pure's Hero.astro composition: the same image is duplicated,
 * blurred, right-aligned and offset below the cover. The parent media
 * capability owns lifecycle; this component owns only the decorative copy.
 */
import { Image } from 'astro:assets'
import type { ReadingImageSource } from '@/lib/content-layer/reading-data'
import type { ReadingOpeningMediaBackdropVariant } from '@/lib/content-layer/reading-policy'

interface Props {
  source: ReadingImageSource
  src: string
  variant?: ReadingOpeningMediaBackdropVariant
}

const { source, src, variant = 'projected-blur' } = Astro.props as Props
const imageMetadata = typeof source === 'string' ? undefined : source
---

{
  imageMetadata ? (
    <Image
      alt=''
      aria-hidden='true'
      fetchpriority='high'
      loading='eager'
      data-reading-opening-media-backdrop
      data-reading-opening-media-backdrop-variant={variant}
      class:list={[
        'reading-opening-media__backdrop pointer-events-none absolute z-0',
        variant === 'projected-blur'
          ? 'end-0 top-4 mt-0 h-full max-w-[65ch] rounded-3xl opacity-60 transition-opacity duration-300'
          : undefined
      ]}
      src={imageMetadata}
    />
  ) : (
    <img
      alt=''
      aria-hidden='true'
      fetchpriority='high'
      loading='eager'
      data-reading-opening-media-backdrop
      data-reading-opening-media-backdrop-variant={variant}
      class:list={[
        'reading-opening-media__backdrop pointer-events-none absolute z-0',
        variant === 'projected-blur'
          ? 'end-0 top-4 mt-0 h-full max-w-[65ch] rounded-3xl opacity-60 transition-opacity duration-300'
          : undefined
      ]}
      src={src}
    />
  )
}

<style is:global>
  [data-reading-opening-media-backdrop] {
    display: block;
    pointer-events: none;
  }

  /* Legacy mode stays available for a safe rollback and for explicit page
     overrides. It intentionally keeps the former visual contract. */
  [data-reading-opening-media-backdrop][data-reading-opening-media-backdrop-variant='blur'] {
    top: 0.5rem;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.36;
    filter: blur(17px) saturate(0.9) contrast(0.92) brightness(1.04);
    transform: translate(0.75rem, 0.375rem) scale(1.04, 0.975);
    transform-origin: center top;
    -webkit-mask-image: radial-gradient(
      ellipse 110% 100% at 70% 32%,
      #000 0%,
      #000 44%,
      rgb(0 0 0 / 0.82) 66%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse 110% 100% at 70% 32%,
      #000 0%,
      #000 44%,
      rgb(0 0 0 / 0.82) 66%,
      transparent 100%
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  /* Reference-compatible mode, copied from Astro Pure's Hero.astro. The
     utility classes above provide `end-0 top-4`, the lower-right projection,
     and the four-step opacity animation is driven by the runtime below. */
  [data-reading-opening-media-backdrop][data-reading-opening-media-backdrop-variant='projected-blur'] {
    filter: blur(24px);
  }

  @supports not ((filter: blur(1px))) {
    [data-reading-opening-media-backdrop][data-reading-opening-media-backdrop-variant='projected-blur'] {
      opacity: 0 !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reading-opening-media-backdrop] {
      transition: none;
    }
  }
</style>
