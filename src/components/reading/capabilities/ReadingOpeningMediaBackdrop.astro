---
/**
 * Optional backdrop attached to opening media. It is deliberately source
 * agnostic: the parent media capability owns placement and lifecycle, while
 * this component owns only the decorative duplicate image.
 */
import { Image } from 'astro:assets'
import type { ReadingImageSource } from '@/lib/content-layer/reading-data'

interface Props {
  source: ReadingImageSource
  src: string
}

const { source, src } = Astro.props as Props
const imageMetadata = typeof source === 'string' ? undefined : source
---

{
  imageMetadata ? (
    <Image
      alt=''
      aria-hidden='true'
      fetchpriority='high'
      loading='eager'
      data-reading-opening-media-backdrop
      class='reading-opening-media__backdrop pointer-events-none absolute inset-x-0 top-2 z-0 m-0 h-full w-full rounded-3xl object-contain transition-opacity duration-300'
      src={imageMetadata}
    />
  ) : (
    <img
      alt=''
      aria-hidden='true'
      fetchpriority='high'
      loading='eager'
      data-reading-opening-media-backdrop
      class='reading-opening-media__backdrop pointer-events-none absolute inset-x-0 top-2 z-0 m-0 h-full w-full rounded-3xl object-contain transition-opacity duration-300'
      src={src}
    />
  )
}

<style is:global>
  [data-reading-opening-media-backdrop] {
    --reading-opening-media-backdrop-opacity: 0.36;
    --reading-opening-media-backdrop-blur: 17px;
    opacity: var(--reading-opening-media-backdrop-opacity);
    filter: blur(var(--reading-opening-media-backdrop-blur)) saturate(0.9) contrast(0.92)
      brightness(1.04);
    /* Spread the ambient layer slightly to the right without growing its
       vertical tail. The main image remains the visual anchor above it. */
    transform: translate(0.75rem, 0.375rem) scale(1.04, 0.975);
    transform-origin: center top;
    -webkit-mask-image: radial-gradient(
      ellipse 110% 100% at 70% 32%,
      #000 0%,
      #000 44%,
      rgb(0 0 0 / 0.82) 66%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse 110% 100% at 70% 32%,
      #000 0%,
      #000 44%,
      rgb(0 0 0 / 0.82) 66%,
      transparent 100%
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  @media (max-width: 639px) {
    [data-reading-opening-media-backdrop] {
      --reading-opening-media-backdrop-opacity: 0.31;
      --reading-opening-media-backdrop-blur: 15px;
      transform: translate(0.5rem, 0.25rem) scale(1.03, 0.975);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reading-opening-media-backdrop] {
      transition: none;
    }
  }
</style>
