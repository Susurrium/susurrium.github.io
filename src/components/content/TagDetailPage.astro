---
import type { Page } from 'astro'

import { Paginator } from 'astro-pure/components/pages'
import { Button } from 'astro-pure/user'

import ContentCard from '@/components/cards/ContentCard.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import {
  getContentTypeDefinition,
  hydratePageItems,
  loadContentCatalog,
  toPaginatorProps,
  type ContentKind,
  type PageItem
} from '@/lib/content-layer'

interface Props {
  kind: ContentKind
  page: Page<PageItem>
}

const { kind, page } = Astro.props as Props
const tag = Astro.params.tag ?? ''
const definition = getContentTypeDefinition(kind)
const catalog = await loadContentCatalog()
const renderItems = hydratePageItems(page.data, catalog)

const meta = {
  description: `Browse ${definition.label} entries tagged #${tag}.`,
  title: `${definition.label} · #${tag}${page.currentPage > 1 ? ` · Page ${page.currentPage}` : ''}`
}

const paginationProps = toPaginatorProps(page)
---

<PageLayout {meta}>
  <Button title='Back' href={definition.basePath} variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 id={`${kind}-tag-heading`} class='mb-6 flex items-end gap-x-2 text-3xl font-medium'>
        {definition.label} tag:
        <span class='text-2xl'>#{tag}</span>
      </h1>
    </div>

    <section
      id='content'
      class='animate'
      aria-labelledby={`${kind}-tag-heading`}
      data-content-kind={kind}
      data-taxonomy-scope={kind}
      data-taxonomy-tag={tag}
    >
      {
        renderItems.length > 0 ? (
          <>
            <ul class='flex flex-col gap-y-3 text-start'>
              {renderItems.map((item) => <ContentCard item={item} />)}
            </ul>
            <Paginator {...paginationProps} />
          </>
        ) : (
          <p class='site-empty-state'>No {definition.label.toLowerCase()} entries with this tag yet.</p>
        )
      }
    </section>
  </main>
</PageLayout>
