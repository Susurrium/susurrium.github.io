---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import type { IconsType } from 'astro-pure/types'
import { Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'

interface Project {
  image?: string
  name: string
  description: string
  links: {
    type: string
    href: string
  }[]
}

interface Props {
  class?: string
  emptyText?: string
  projects: Project[]
}
const { class: className, emptyText, projects, ...props } = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/*.{jpeg,jpg,png,gif,avif,webp}'
)
const projectIconSet: Record<string, IconsType> = {
  github: 'github-circle',
  site: 'earth',
  doc: 'document',
  release: 'package'
}
const projectLinkLabels: Record<string, string> = {
  github: 'Open on GitHub',
  site: 'Visit website',
  doc: 'Read documentation',
  release: 'View release'
}
---

<div class={className} {...props}>
  {
    projects.length > 0 ? (
      <div class='grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2 sm:gap-y-4'>
        {projects.map((project) => {
          var imagePath = null
          const primaryLink = project.links[0]
          if (project.image) {
            imagePath = '/src/assets/projects/' + project.image
            if (!images[imagePath])
              throw new Error(
                `"${imagePath}" does not exist in glob: "src/assets/projects/*.{jpeg,jpg,png,gif,avif,webp}"`
              )
          }

          return (
            <div
              class='site-card-surface site-card-surface--interactive relative overflow-hidden rounded-xl border'
              data-card-surface='standard'
            >
              {imagePath && (
                <Image
                  class='absolute end-0 z-0 m-0 h-full w-1/2 object-cover opacity-40'
                  src={images[imagePath]()}
                  alt=''
                  aria-hidden='true'
                  loading='lazy'
                  style={{
                    maskImage:
                      'linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%)',
                    msMaskImage:
                      '-ms-linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%)',
                    WebkitMaskImage:
                      '-webkit-linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%)'
                  }}
                />
              )}
              <div
                class={cn('relative z-10 flex flex-col gap-y-2 p-3 sm:px-4', imagePath && 'me-20')}
              >
                {primaryLink ? (
                  <a
                    class='line-clamp-1 rounded-sm font-medium text-foreground no-underline transition-colors'
                    href={primaryLink.href}
                    target='_blank'
                    rel='noopener noreferrer'
                  >
                    {project.name}
                  </a>
                ) : (
                  <span class='line-clamp-1 font-medium text-foreground'>{project.name}</span>
                )}
                <div class='line-clamp-2 leading-snug text-muted-foreground sm:h-12'>
                  {project.description}
                </div>
                <div class='flex flex-row items-center gap-x-2 sm:gap-x-3'>
                  {project.links.map((link) => {
                    const icon = projectIconSet[link.type] ?? 'link'
                    return (
                      <a
                        href={link.href}
                        class='rounded-full bg-muted p-1 text-muted-foreground transition-colors hover:text-primary focus-visible:text-primary sm:p-1.5'
                        aria-label={projectLinkLabels[link.type] ?? 'Open project link'}
                        target='_blank'
                        rel='noopener noreferrer'
                      >
                        <Icon class='size-5' name={icon} />
                      </a>
                    )
                  })}
                </div>
              </div>
            </div>
          )
        })}
      </div>
    ) : (
      <p
        class='site-card-surface site-empty-state text-muted-foreground'
        data-project-empty
      >
        {emptyText ?? '暂无项目。'}
      </p>
    )
  }
</div>
