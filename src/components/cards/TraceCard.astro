---
/**
 * Trace's content adapter for the Media visual primitive.
 *
 * The adapter receives a canonical card projection; it does not read Trace
 * frontmatter or choose a source collection.  The visual primitive below is
 * intentionally unchanged so this data-layer migration has no styling
 * responsibility.
 */
import MediaCard from '@/components/cards/MediaCard.astro'
import type { ContentPresentation, MediaCardData } from '@/lib/content-layer/types'

interface Props {
  actionLabel?: string
  class?: string
  data: MediaCardData
  headingLevel?: 2 | 3 | 4 | 5 | 6
  index?: number
  presentation?: ContentPresentation
}

const {
  actionLabel = 'Read',
  class: className,
  data,
  headingLevel,
  index = 0,
  presentation = 'media-content'
} = Astro.props
---

<MediaCard
  actionLabel={actionLabel}
  class={className}
  contentId={data.contentId}
  contentType={data.contentType}
  date={data.date}
  description={data.description}
  footerText={data.footerText}
  {headingLevel}
  href={data.href}
  image={data.image}
  index={index}
  {presentation}
  title={data.title}
/>
