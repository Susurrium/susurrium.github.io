---
/**
 * A generic, no-image adaptation of the astro-pure PostPreview surface.
 *
 * Blog keeps its fuller ArthalsBlogCard adapter (reading time and linked Blog
 * tags). This primitive exists so a page-level presentation override can
 * still render a Trace or Saying as `arthals-text`, rather than silently
 * reverting to a content-type-specific component.
 */
import { cn } from 'astro-pure/utils'
import { FormattedDate } from 'astro-pure/user'
import type { ContentKind } from '@/data/home-media'

interface Props {
  class?: string
  contentId: string
  contentType: ContentKind
  date: Date
  description?: string
  detailed?: boolean
  href: string
  title: string
}

const { class: className, contentId, contentType, date, description, detailed = false, href, title } = Astro.props
---

<article
  class={cn('arthals-text-card', className)}
  data-content-id={contentId}
  data-content-type={contentType}
  data-image-source='none'
  data-presentation='arthals-text'
>
  <a
    class={cn(
      'group relative block w-full rounded-2xl border bg-background px-5 py-2.5 transition-colors ease-in-out hover:bg-muted hover:text-primary',
      detailed && 'max-sm:px-4 sm:py-5'
    )}
    href={href}
    data-astro-prefetch
  >
    <div class={cn('relative flex flex-col gap-1', !detailed && 'sm:flex-row sm:items-center')}>
      <FormattedDate class='min-w-[95px] text-xs' date={date} />
      <div class='flex flex-grow justify-between gap-x-3'>
        <div class={detailed ? 'font-medium' : undefined}>{title}</div>
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='arthals-text-card__redirect my-1 shrink-0 stroke-muted-foreground'
          aria-hidden='true'
          ><line
            x1='5'
            y1='12'
            x2='19'
            y2='12'
            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100'
          ></line><polyline
            points='12 5 19 12 12 19'
            class='translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1'
          ></polyline></svg
        >
      </div>
      {detailed && description && <p class='line-clamp-3 text-sm text-muted-foreground'>{description}</p>}
    </div>
  </a>
</article>

<style>
  .arthals-text-card > a:hover .arthals-text-card__redirect,
  .arthals-text-card > a:focus-visible .arthals-text-card__redirect {
    stroke: hsl(var(--primary));
  }
</style>
