---
/**
 * Saying's content adapter for the shared Media visual primitive.
 * Decoration, attribution text, and route have already been projected by the
 * content layer.  This component only preserves the existing visual call.
 */
import MediaCard from '@/components/cards/MediaCard.astro'
import type { ContentPresentation, MediaCardData } from '@/lib/content-layer/types'

interface Props {
  actionLabel?: string
  archiveIndex?: number
  class?: string
  data: MediaCardData
  headingLevel?: 2 | 3 | 4 | 5 | 6
  presentation?: ContentPresentation
}

const {
  actionLabel = 'Read',
  archiveIndex = 0,
  class: className,
  data,
  headingLevel,
  presentation = 'media-decorative'
} = Astro.props
---

<MediaCard
  actionLabel={actionLabel}
  class={className}
  contentId={data.contentId}
  contentType={data.contentType}
  description={data.description ?? ''}
  footerText={data.footerText}
  {headingLevel}
  href={data.href}
  image={data.image}
  index={archiveIndex}
  {presentation}
  title={data.title}
/>
