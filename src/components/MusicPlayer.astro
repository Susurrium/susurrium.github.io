---
/**
 * Persistent, local-only music shell.
 *
 * Sources: `HIST-MUSIC` in the fixed historical snapshot provides the daily
 * selection, localStorage and media lifecycle model. `XYX-MUSIC-UI` is locked
 * to xyx404/xyx404.github.io@d4e1efc; its isolated `#nav-music` pill/record/
 * hover visual is adapted below. Its Meting/APlayer/NetEase runtime is not
 * transferable because this static site permits only local media.
 */
import { dailyMusic } from '@/data/music'

const serializedTracks = JSON.stringify(dailyMusic).replace(/</g, '\\u003c')
---

<music-player
  id='global-music-player'
  data-global-music-player
  data-music-compact='false'
  data-music-player
  data-placeholder='true'
  data-playback-state='paused'
  data-time-zone='Asia/Shanghai'
  data-tracks={serializedTracks}
>
  <button
    class='music-player__toggle focus-ring'
    type='button'
    data-music-toggle
    aria-controls='music-player-panel'
    aria-expanded='false'
    aria-label='打开音乐播放器'
    title='Music'
  >
    <!--
      This is the isolated, local equivalent of XYX404's `#nav-music`
      APlayer shell: a compact rotating record, truncated title, hover prompt,
      and a subtle playback bar.  It deliberately contains no Meting/APlayer
      runtime or remote playlist request.
    -->
    <span class='music-player__aplayer'>
      <span class='music-player__body'>
        <span class='music-player__pic' aria-hidden='true'>
          <img class='music-player__cover' data-music-cover alt='' hidden />
          <span class='music-player__pic-grooves'></span>
          <span class='music-player__pic-hole'></span>
        </span>
        <span class='music-player__info'>
          <span class='music-player__music'>
            <span class='music-player__toggle-copy' data-music-pill-title>本地音乐准备中</span>
          </span>
          <span class='music-player__controller' aria-hidden='true'>
            <span class='music-player__bar'>
              <span class='music-player__played'></span>
            </span>
          </span>
        </span>
      </span>
    </span>
    <span class='music-player__hover-tip' aria-hidden='true'>播放音乐</span>
  </button>

  <section
    id='music-player-panel'
    class='music-player__panel'
    data-music-panel
    aria-label='每日音乐播放器'
    hidden
  >
    <header class='music-player__header'>
      <div class='music-player__identity'>
        <span class='music-player__mini-disc' aria-hidden='true'>♪</span>
        <div>
          <p class='music-player__eyebrow'>Today’s sound</p>
          <h2 data-music-title>本地音乐准备中</h2>
          <p data-music-artist>本地占位曲目</p>
        </div>
      </div>
      <button
        class='music-player__close focus-ring'
        type='button'
        data-music-close
        aria-label='关闭音乐面板'
      >
        <span aria-hidden='true'>×</span>
      </button>
    </header>

    <p class='music-player__reason' data-music-reason>等待一段能留在今天的声音。</p>
    <p class='music-player__context' data-music-context></p>

    <p class='music-player__placeholder' data-music-placeholder-notice>
      当前是本地占位条目，尚未加载音频。之后只需放入本站静态文件并配置同源路径即可启用播放。
    </p>

    <div class='music-player__controls' aria-label='音乐控制'>
      <button
        class='music-player__control focus-ring'
        type='button'
        data-music-prev
        aria-label='上一首'
      >
        <span aria-hidden='true'>‹‹</span>
      </button>
      <button
        class='music-player__play focus-ring'
        type='button'
        data-music-play
        aria-describedby='music-player-status'
        aria-label='播放'
        disabled
      >
        <span data-music-play-icon aria-hidden='true'>▶</span>
      </button>
      <button
        class='music-player__control focus-ring'
        type='button'
        data-music-next
        aria-label='下一首'
      >
        <span aria-hidden='true'>››</span>
      </button>
      <label class='music-player__volume'>
        <span class='sr-only'>音量</span>
        <span class='music-player__volume-icon' aria-hidden='true'>◔</span>
        <input data-music-volume type='range' min='0' max='1' step='0.05' value='0.8' />
      </label>
    </div>

    <p id='music-player-status' class='music-player__status' data-music-status aria-live='polite'>
      当前仅有占位条目，未加载音频。
    </p>
  </section>

  <!-- Exactly one media element. It receives a source only for future local paths. -->
  <audio data-music-audio preload='none'></audio>
</music-player>

<script>
  type MusicTrack = {
    id: string
    title: string
    artist?: string
    audioSrc?: string
    coverSrc?: string
    reason?: string
    context?: string
    tags?: readonly string[]
    licenseNote?: string
  }

  const storagePrefix = 'susurrium:music:v1'

  class MusicPlayerElement extends HTMLElement {
    private controller: AbortController | null = null
    private modeObserver: MutationObserver | null = null
    private tracks: MusicTrack[] = []
    private index = 0
    private audio: HTMLAudioElement | null = null
    private panel: HTMLElement | null = null
    private toggle: HTMLButtonElement | null = null
    private playButton: HTMLButtonElement | null = null
    private titleElement: HTMLElement | null = null
    private artistElement: HTMLElement | null = null
    private reasonElement: HTMLElement | null = null
    private contextElement: HTMLElement | null = null
    private placeholderElement: HTMLElement | null = null
    private statusElement: HTMLElement | null = null
    private playIcon: HTMLElement | null = null
    private pillTitleElement: HTMLElement | null = null
    private coverElement: HTMLImageElement | null = null
    private userActivated = false

    connectedCallback() {
      this.disconnect()

      this.audio = this.querySelector<HTMLAudioElement>('[data-music-audio]')
      this.panel = this.querySelector<HTMLElement>('[data-music-panel]')
      this.toggle = this.querySelector<HTMLButtonElement>('[data-music-toggle]')
      this.playButton = this.querySelector<HTMLButtonElement>('[data-music-play]')
      this.titleElement = this.querySelector<HTMLElement>('[data-music-title]')
      this.artistElement = this.querySelector<HTMLElement>('[data-music-artist]')
      this.reasonElement = this.querySelector<HTMLElement>('[data-music-reason]')
      this.contextElement = this.querySelector<HTMLElement>('[data-music-context]')
      this.placeholderElement = this.querySelector<HTMLElement>('[data-music-placeholder-notice]')
      this.statusElement = this.querySelector<HTMLElement>('[data-music-status]')
      this.playIcon = this.querySelector<HTMLElement>('[data-music-play-icon]')
      this.pillTitleElement = this.querySelector<HTMLElement>('[data-music-pill-title]')
      this.coverElement = this.querySelector<HTMLImageElement>('[data-music-cover]')

      try {
        const candidate: unknown = JSON.parse(this.dataset.tracks ?? '[]')
        this.tracks = Array.isArray(candidate) ? (candidate as MusicTrack[]) : []
      } catch {
        this.tracks = []
      }

      if (!this.audio || !this.panel || !this.toggle || !this.playButton) return

      this.controller = new AbortController()
      const { signal } = this.controller
      this.audio.autoplay = false
      this.index = this.restoreDailySelection()
      this.audio.volume = this.clampUnit(this.storageGet('volume'), 0.8)
      const volumeInput = this.querySelector<HTMLInputElement>('[data-music-volume]')
      if (volumeInput) volumeInput.value = String(this.audio.volume)

      this.toggle.addEventListener('click', this.togglePanel, { signal })
      this.querySelector<HTMLButtonElement>('[data-music-close]')?.addEventListener(
        'click',
        this.closePanel,
        { signal }
      )
      this.playButton.addEventListener('click', this.togglePlayback, { signal })
      this.querySelector<HTMLButtonElement>('[data-music-prev]')?.addEventListener(
        'click',
        () => this.select(-1),
        { signal }
      )
      this.querySelector<HTMLButtonElement>('[data-music-next]')?.addEventListener(
        'click',
        () => this.select(1),
        { signal }
      )
      volumeInput?.addEventListener('input', this.changeVolume, { signal })
      this.audio.addEventListener('play', this.syncPlayback, { signal })
      this.audio.addEventListener('pause', this.syncPlayback, { signal })
      this.audio.addEventListener('ended', this.handleEnded, { signal })
      this.audio.addEventListener('error', this.handleError, { signal })
      this.audio.addEventListener('loadedmetadata', this.restorePosition, { signal })
      this.audio.addEventListener('timeupdate', this.persistPosition, { signal })
      window.addEventListener('beforeunload', this.persistPosition, { signal })
      document.addEventListener('visibilitychange', this.handleVisibility, { signal })
      document.addEventListener('keydown', this.handleKeydown, { signal })
      // `astro:after-swap` is the router update moment; `astro:page-load`
      // also runs after a full load and after an Astro client-side visit.
      document.addEventListener('astro:after-swap', this.handleNavigationUpdate, { signal })
      document.addEventListener('astro:page-load', this.handleNavigationUpdate, { signal })

      this.render()
      this.observePresentationMode()
      this.syncPresentationMode()
    }

    disconnectedCallback() {
      this.disconnect()
    }

    private disconnect() {
      this.persistPosition()
      this.controller?.abort()
      this.controller = null
      this.modeObserver?.disconnect()
      this.modeObserver = null
    }

    private restoreDailySelection() {
      if (this.tracks.length === 0) return 0

      const today = this.dayKey()
      const storedDate = this.storageGet('selection-date')
      const storedIndex = Number(this.storageGet('selection-index'))
      if (storedDate === today && Number.isInteger(storedIndex) && storedIndex >= 0) {
        return storedIndex % this.tracks.length
      }

      const index = this.dailyIndex(today)
      this.storageSet('selection-date', today)
      this.storageSet('selection-index', String(index))
      return index
    }

    private dayKey() {
      try {
        return new Intl.DateTimeFormat('en-CA', {
          timeZone: this.dataset.timeZone || 'Asia/Shanghai',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit'
        }).format(new Date())
      } catch {
        return new Date().toISOString().slice(0, 10)
      }
    }

    private dailyIndex(key: string) {
      let hash = 2166136261
      for (const character of key) hash = Math.imul(hash ^ character.charCodeAt(0), 16777619)
      return (hash >>> 0) % this.tracks.length
    }

    private current() {
      return this.tracks[this.index]
    }

    private render() {
      const track = this.current()
      if (!track || !this.audio || !this.playButton) {
        this.dataset.placeholder = 'true'
        this.setStatus('音乐目录尚未准备好。')
        return
      }

      const localSource = this.localAudioSource(track.audioSrc)
      const localCover = this.localAudioSource(track.coverSrc)
      const sourceChanged = (this.audio.getAttribute('src') ?? '') !== (localSource ?? '')
      if (sourceChanged) {
        this.audio.pause()
        if (localSource) this.audio.src = localSource
        else this.audio.removeAttribute('src')
        this.audio.load()
      }

      if (this.titleElement) this.titleElement.textContent = track.title
      if (this.pillTitleElement) this.pillTitleElement.textContent = track.title
      if (this.coverElement) {
        this.coverElement.hidden = !localCover
        if (localCover) this.coverElement.src = localCover
        else this.coverElement.removeAttribute('src')
      }
      if (this.artistElement) this.artistElement.textContent = track.artist || '本站本地音乐'
      if (this.reasonElement)
        this.reasonElement.textContent = track.reason || '把喜欢的声音留在今天。'
      if (this.contextElement) this.contextElement.textContent = track.context || ''
      if (this.placeholderElement) this.placeholderElement.hidden = Boolean(localSource)
      this.playButton.disabled = !localSource
      this.playButton.setAttribute('aria-disabled', String(!localSource))
      this.dataset.placeholder = localSource ? 'false' : 'true'
      this.dataset.cover = localCover ? 'true' : 'false'
      this.persistSelection()
      this.setStatus(
        localSource
          ? track.licenseNote || '本地音频已准备好；点击播放以启用声音。'
          : track.licenseNote || '当前仅有本地占位条目，未加载音频。'
      )
      this.syncPlayback()
    }

    private togglePanel = () => {
      if (!this.panel || !this.toggle) return
      if (this.isCompactMode()) {
        // In the compact reading state the persistent pill remains a direct
        // play/pause control; the larger panel stays folded and audio is never
        // paused merely because navigation entered a detail page.
        this.togglePlayback()
        return
      }

      const willOpen = this.panel.hidden
      this.panel.hidden = !willOpen
      this.toggle.setAttribute('aria-expanded', String(willOpen))
      if (willOpen)
        this.querySelector<HTMLButtonElement>('[data-music-close]')?.focus({ preventScroll: true })
    }

    private closePanel = () => {
      if (!this.panel || !this.toggle) return
      this.panel.hidden = true
      this.toggle.setAttribute('aria-expanded', 'false')
      this.toggle.focus({ preventScroll: true })
    }

    private togglePlayback = () => {
      const track = this.current()
      if (!this.audio || !this.localAudioSource(track?.audioSrc)) {
        this.setStatus('当前条目仍是占位内容，等待本站本地音频文件。')
        if (this.isCompactMode() && this.toggle) this.toggle.title = '本地音频尚未准备好'
        return
      }

      if (this.audio.paused) {
        // This method is reached directly from a click: the first play request
        // is therefore a real user gesture rather than an autoplay attempt.
        this.userActivated = true
        void this.playFromUserGesture()
      } else {
        this.audio.pause()
      }
    }

    private async playFromUserGesture() {
      if (!this.audio || !this.localAudioSource(this.current()?.audioSrc)) return
      try {
        await this.audio.play()
      } catch {
        this.setStatus('浏览器暂未允许播放，请再次主动点击播放按钮。')
        this.syncPlayback()
      }
    }

    private select = (offset: number, resume = false) => {
      if (this.tracks.length === 0) return
      const wasPlaying = Boolean(this.audio && !this.audio.paused)
      this.persistPosition()
      this.audio?.pause()
      this.index = (this.index + offset + this.tracks.length) % this.tracks.length
      this.render()
      if ((resume || wasPlaying) && this.userActivated) void this.playFromUserGesture()
    }

    private handleEnded = () => {
      const track = this.current()
      if (track) this.storageRemove(`position:${track.id}`)
      this.select(1, this.userActivated)
    }

    private changeVolume = (event: Event) => {
      const input = event.currentTarget as HTMLInputElement
      if (!this.audio) return
      this.audio.volume = this.clampUnit(input.value, this.audio.volume)
      this.storageSet('volume', String(this.audio.volume))
    }

    private syncPlayback = () => {
      const playing = Boolean(this.audio && !this.audio.paused && this.audio.currentSrc)
      this.classList.toggle('is-playing', playing)
      this.dataset.playbackState = playing ? 'playing' : 'paused'
      this.playButton?.setAttribute('aria-label', playing ? '暂停' : '播放')
      if (this.playIcon) this.playIcon.textContent = playing ? 'Ⅱ' : '▶'
      if (this.isCompactMode() && this.toggle) {
        const label = this.localAudioSource(this.current()?.audioSrc)
          ? playing
            ? '暂停音乐'
            : '播放音乐'
          : '本地音频尚未准备好'
        this.toggle.setAttribute('aria-label', label)
        this.toggle.title = label
      }
      if (playing) this.setStatus('正在播放 · 点击暂停')
    }

    private handleError = () => {
      this.audio?.pause()
      this.setStatus('本地音频暂时不可用，请检查文件路径和编码。')
      this.syncPlayback()
    }

    private persistSelection() {
      if (!this.tracks.length) return
      this.storageSet('selection-date', this.dayKey())
      this.storageSet('selection-index', String(this.index))
    }

    private persistPosition = () => {
      const track = this.current()
      if (!this.audio || !track) return
      this.persistSelection()
      if (Number.isFinite(this.audio.currentTime) && this.audio.currentTime > 0) {
        this.storageSet(`position:${track.id}`, String(this.audio.currentTime))
      }
    }

    private restorePosition = () => {
      const track = this.current()
      if (
        !this.audio ||
        !track ||
        !Number.isFinite(this.audio.duration) ||
        this.audio.duration <= 0
      )
        return
      const savedPosition = Number(this.storageGet(`position:${track.id}`))
      if (
        Number.isFinite(savedPosition) &&
        savedPosition > 0 &&
        savedPosition < this.audio.duration - 0.5
      ) {
        this.audio.currentTime = savedPosition
      }
    }

    private handleVisibility = () => {
      if (document.visibilityState === 'hidden') this.persistPosition()
    }

    private handleKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape' && this.panel && !this.panel.hidden) this.closePanel()
    }

    private handleNavigationUpdate = () => {
      // The body can be replaced by Astro's ClientRouter, so reattach the
      // attribute observer before applying the compact detail-page state.
      queueMicrotask(() => {
        this.observePresentationMode()
        this.syncPresentationMode()
      })
    }

    private observePresentationMode() {
      this.modeObserver?.disconnect()
      if (!document.body) return
      this.modeObserver = new MutationObserver(this.syncPresentationMode)
      this.modeObserver.observe(document.body, {
        attributes: true,
        attributeFilter: ['data-music-mode']
      })
    }

    private syncPresentationMode = () => {
      const compact = this.isCompactMode()
      this.classList.toggle('is-compact', compact)
      this.dataset.musicCompact = String(compact)
      this.dataset.mode = compact ? 'compact' : 'full'
      if (compact && this.panel && this.toggle) {
        // Do not call audio.pause(): entering a reading page only collapses UI.
        this.panel.hidden = true
        this.toggle.setAttribute('aria-expanded', 'false')
        this.syncPlayback()
      } else if (this.toggle) {
        this.toggle.setAttribute('aria-label', '打开音乐播放器')
        this.toggle.title = 'Music'
      }
    }

    private isCompactMode() {
      return document.body?.dataset.musicMode === 'compact'
    }

    private localAudioSource(source?: string) {
      if (!source || !source.trim()) return undefined
      try {
        const resolved = new URL(source, window.location.href)
        return resolved.origin === window.location.origin ? source : undefined
      } catch {
        return undefined
      }
    }

    private setStatus(message: string) {
      if (this.statusElement) this.statusElement.textContent = message
    }

    private clampUnit(value: string | number | null, fallback: number) {
      const numeric = Number(value)
      return Number.isFinite(numeric) ? Math.max(0, Math.min(1, numeric)) : fallback
    }

    private storageKey(key: string) {
      return `${storagePrefix}:${key}`
    }

    private storageGet(key: string) {
      try {
        return localStorage.getItem(this.storageKey(key))
      } catch {
        return null
      }
    }

    private storageSet(key: string, value: string) {
      try {
        localStorage.setItem(this.storageKey(key), value)
      } catch {
        // Private browsing can disable Storage; playback remains functional.
      }
    }

    private storageRemove(key: string) {
      try {
        localStorage.removeItem(this.storageKey(key))
      } catch {
        // See storageSet above.
      }
    }
  }

  if (!customElements.get('music-player')) {
    customElements.define('music-player', MusicPlayerElement)
  }
</script>

<style>
  music-player {
    position: fixed;
    z-index: var(--z-music);
    left: max(1rem, env(safe-area-inset-left));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: block;
    color: hsl(var(--foreground));
  }

  .music-player__toggle {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    gap: 0.58rem;
    border: 1px solid hsl(var(--border) / 0.86);
    border-radius: 999px;
    padding: 0.35rem 0.82rem 0.35rem 0.38rem;
    background: hsl(var(--background) / 0.86);
    color: hsl(var(--foreground));
    box-shadow: 0 0.8rem 2.25rem hsl(var(--foreground) / 0.16);
    cursor: pointer;
    backdrop-filter: blur(1rem);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .music-player__toggle:hover,
  .music-player__toggle:focus-visible {
    border-color: hsl(var(--primary) / 0.7);
    box-shadow: 0 1rem 2.6rem hsl(var(--foreground) / 0.22);
    transform: translateY(-0.15rem);
  }

  .music-player__disc,
  .music-player__mini-disc {
    position: relative;
    display: grid;
    border-radius: 50%;
    place-items: center;
    color: hsl(var(--primary-foreground));
    background:
      radial-gradient(circle at center, hsl(var(--primary-foreground) / 0.88) 0 8%, transparent 9%),
      repeating-radial-gradient(
        circle at center,
        hsl(var(--primary-foreground) / 0.22) 0 1px,
        transparent 2px 5px
      ),
      hsl(var(--primary));
  }

  .music-player__disc {
    width: 2.42rem;
    height: 2.42rem;
  }

  .music-player__disc-dot {
    width: 0.26rem;
    height: 0.26rem;
    border-radius: 50%;
    background: hsl(var(--background));
  }

  .music-player__equalizer {
    position: absolute;
    right: -0.08rem;
    bottom: 0.28rem;
    display: flex;
    height: 0.68rem;
    align-items: end;
    gap: 0.08rem;
    padding: 0.1rem;
    border-radius: 0.26rem;
    background: hsl(var(--background));
  }

  .music-player__equalizer i {
    display: block;
    width: 0.1rem;
    height: 0.24rem;
    border-radius: 999px;
    background: hsl(var(--primary));
  }

  .music-player__equalizer i:nth-child(2) {
    height: 0.44rem;
  }

  .music-player__equalizer i:nth-child(3) {
    height: 0.34rem;
  }

  music-player.is-playing .music-player__disc,
  music-player.is-playing .music-player__mini-disc {
    animation: music-player-spin 4.2s linear infinite;
  }

  music-player.is-playing .music-player__equalizer i {
    animation: music-player-pulse 0.9s ease-in-out infinite alternate;
  }

  music-player.is-playing .music-player__equalizer i:nth-child(2) {
    animation-delay: -0.24s;
  }

  music-player.is-playing .music-player__equalizer i:nth-child(3) {
    animation-delay: -0.48s;
  }

  .music-player__toggle-copy {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .music-player__panel {
    position: absolute;
    bottom: calc(100% + 0.72rem);
    left: 0;
    width: min(22rem, calc(100vw - 2rem));
    border: 1px solid hsl(var(--border));
    border-radius: 1rem;
    padding: 1rem;
    background: hsl(var(--card) / 0.96);
    box-shadow: 0 1.4rem 4rem hsl(var(--foreground) / 0.18);
    backdrop-filter: blur(1.1rem);
  }

  .music-player__panel[hidden] {
    display: none;
  }

  .music-player__header,
  .music-player__identity,
  .music-player__controls,
  .music-player__volume {
    display: flex;
    align-items: center;
  }

  .music-player__header {
    justify-content: space-between;
    gap: 1rem;
  }

  .music-player__identity {
    min-width: 0;
    gap: 0.7rem;
  }

  .music-player__mini-disc {
    width: 2.3rem;
