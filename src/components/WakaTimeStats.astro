---
import { formatWakaTimeDuration, loadWakaTimeBuildSnapshot } from '@/lib/wakatime'

interface Props {
  class?: string
}

const { class: className } = Astro.props
const repository = 'https://github.com/Susurrium/wakatime-stats'
const snapshot = await loadWakaTimeBuildSnapshot()
const metrics = [
  { key: 'vscode', label: 'Code Time', value: snapshot.metrics.vscode.seconds },
  { key: 'codexAi', label: 'AI Code Time', value: snapshot.metrics.codexAi.seconds }
]
---

<wakatime-stats
  class:list={['wakatime-stats not-prose', className]}
  data-wakatime-stats
  data-source-updated-at={snapshot.sourceUpdatedAt}
>
  <a
    href={repository}
    target='_blank'
    rel='noopener noreferrer'
    class='wakatime-stats__surface'
    title='查看 WakaTime 累计编程统计'
  >
    <dl class='wakatime-stats__metrics'>
      {
        metrics.map(({ key, label, value }) => (
          <div class='wakatime-stats__metric'>
            <dt>{label}</dt>
            <dd data-wakatime-value={key}>{formatWakaTimeDuration(value)}</dd>
          </div>
        ))
      }
    </dl>
  </a>
</wakatime-stats>

<script>
  import '@/scripts/wakatime-stats'
</script>

<style>
  .wakatime-stats {
    display: block;
    width: fit-content;
    max-width: 100%;
    min-width: 0;
  }

  .wakatime-stats__surface {
    display: block;
    padding: 0.625rem 0.875rem;
    border: 1px solid hsl(var(--border) / 0.8);
    border-radius: 0.75rem;
    background: hsl(var(--background) / 0.92);
    color: hsl(var(--foreground));
    text-decoration: none;
  }

  .wakatime-stats__surface:hover {
    border-color: hsl(var(--foreground) / 0.25);
  }

  .wakatime-stats__surface:focus-visible {
    outline: 2px solid hsl(var(--foreground) / 0.65);
    outline-offset: 3px;
  }

  .wakatime-stats__metrics {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin: 0;
  }

  .wakatime-stats__metric {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    white-space: nowrap;
    line-height: 1.25rem;
  }

  .wakatime-stats dt {
    margin: 0;
    padding: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    font-weight: 500;
  }

  .wakatime-stats dd {
    margin: 0;
    padding: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
</style>
