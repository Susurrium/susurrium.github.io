---
interface Props {
  class?: string
}

const { class: className } = Astro.props
const repository = 'https://github.com/Susurrium/wakatime-stats'
const base = 'https://raw.githubusercontent.com/Susurrium/wakatime-stats/main/badges'
const badges = [
  { path: 'coding', label: 'Code Time，WakaTime Coding 分类累计时间' },
  { path: 'ai-coding', label: 'AI Code Time，WakaTime AI Coding 分类累计时间' }
]
---

<div class:list={['wakatime-badges not-prose', className]} data-wakatime-stats>
  {
    badges.map(({ path, label }) => (
      <a href={repository} target='_blank' rel='noopener noreferrer' aria-label={label}>
        <img src={`${base}/${path}/all-time.svg`} alt={label} height='20' loading='lazy' decoding='async' />
      </a>
    ))
  }
</div>

<style>
  .wakatime-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
  }

  .wakatime-badges a {
    display: inline-flex;
    max-width: 100%;
    border-radius: 3px;
  }

  .wakatime-badges a:focus-visible {
    outline: 2px solid hsl(var(--foreground) / 0.65);
    outline-offset: 3px;
  }

  .wakatime-badges img {
    display: block;
    width: auto;
    max-width: 100%;
    height: 20px;
    margin: 0;
  }
</style>
