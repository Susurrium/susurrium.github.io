---
/**
 * The only runtime owner of ambient visual effects.
 *
 * Sources:
 * - `PKU-*`: the three locked butterfly-extsrc@1.1.3 canvas scripts.
 * - `GEORGE-*`: the locked sakura / fireworks / tinycolor / anime scripts.
 * - `HIST-BACKDROP` and `HIST-GEORGE-HOST`: lifecycle and route-scoping
 *   precedent from the fixed historical snapshot.
 *
 * The original vendor scripts create document-global canvases and listeners.
 * Loading each visual family into a disposable same-origin iframe preserves
 * their drawing algorithm while making every RAF, timer and listener vanish
 * when the frame is removed during an Astro ClientRouter navigation.
 */
import { effectProfiles, resolveEffectProfile, type EffectProfile } from '@/data/effects'

interface Props {
  profile?: EffectProfile
}

const profile = resolveEffectProfile(Astro.props.profile)
const enabled = effectProfiles[profile]
const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '')
const asset = (path: string) => `${basePath}${path}`
const serializedSources = JSON.stringify({
  georgeAnime: asset('/vendor/george/anime.min.js'),
  georgeFireworks: asset('/vendor/george/fireworks.js'),
  georgeSakura: asset('/vendor/george/sakura.js'),
  georgeTinycolor: asset('/vendor/george/tinycolor.min.js'),
  pkuFlutter: asset('/vendor/pku/canvas-fluttering-ribbon@1.1.3.min.js'),
  pkuNest: asset('/vendor/pku/canvas-nest@1.1.3.min.js'),
  pkuRibbon: asset('/vendor/pku/canvas-ribbon@1.1.3.min.js')
}).replace(/</g, '\\u003c')
---

<visual-effects-host
  data-visual-effects-host
  data-effect-profile={profile}
  data-pku-backdrop={String(enabled.pkuBackdrop)}
  data-petals={String(enabled.petals)}
  data-click={String(enabled.click)}
  data-companion={String(enabled.companion)}
  data-sources={serializedSources}
  data-active-effects=''
  data-click-burst-count='0'
  data-lifecycle='idle'
  aria-hidden='true'></visual-effects-host>

<script>
  type EffectKind = 'click' | 'petals' | 'pku'

  type VendorSources = {
    georgeAnime: string
    georgeFireworks: string
    georgeSakura: string
    georgeTinycolor: string
    pkuFlutter: string
    pkuNest: string
    pkuRibbon: string
  }

  type EffectPolicy = {
    click: boolean
    petals: boolean
    pkuBackdrop: boolean
  }

  const effectKinds: EffectKind[] = ['pku', 'petals', 'click']
  const pkuMobileQuery = '(max-width: 767px), (pointer: coarse)'

  class VisualEffectsHostElement extends HTMLElement {
    private controller: AbortController | null = null
    private clickController: AbortController | null = null
    private pkuController: AbortController | null = null
    private frames = new Map<EffectKind, HTMLIFrameElement>()
    private motionQuery: MediaQueryList | null = null
    private pkuMobileMedia: MediaQueryList | null = null
    private sources: VendorSources | null = null
    private pkuMessageFrame = 0
    private pkuPointer: { x: number; y: number } | null = null
    private pkuPointerOutside = false
    private pkuScrollY = 0

    connectedCallback() {
      this.destroy()

      // A ClientRouter body swap normally disconnects the old host before this
      // one connects. This small guard also makes a duplicate host impossible
      // if a browser extension or an interrupted transition changes that order.
      document
        .querySelectorAll<VisualEffectsHostElement>('visual-effects-host[data-visual-effects-host]')
        .forEach((host) => {
          if (host !== this) host.remove()
        })

      this.sources = this.readSources()
      if (!this.sources) {
        this.dataset.lifecycle = 'error'
        return
      }

      this.controller = new AbortController()
      const { signal } = this.controller
      this.motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
      this.pkuMobileMedia = window.matchMedia(pkuMobileQuery)

      this.motionQuery.addEventListener('change', this.sync, { signal })
      this.pkuMobileMedia.addEventListener('change', this.sync, { signal })
      document.addEventListener('visibilitychange', this.sync, { signal })
      document.addEventListener('astro:before-preparation', this.pauseForNavigation, { signal })
      document.addEventListener('astro:before-swap', this.pauseForNavigation, { signal })
      window.addEventListener('pagehide', this.pauseForNavigation, { signal })
      window.addEventListener('pageshow', this.sync, { signal })

      this.sync()
    }

    disconnectedCallback() {
      this.destroy()
    }

    private destroy() {
      this.controller?.abort()
      this.controller = null
      this.stopClickForwarder()
      this.stopPkuForwarder()
      this.motionQuery = null
      this.pkuMobileMedia = null

      for (const frame of this.frames.values()) frame.remove()
      this.frames.clear()
      this.replaceChildren()
      this.dataset.activeEffects = ''
      this.dataset.lifecycle = 'stopped'
    }

    private pauseForNavigation = () => {
      this.stopFrames()
      this.dataset.lifecycle = 'navigating'
    }

    private stopFrames() {
      this.stopClickForwarder()
      this.stopPkuForwarder()
      for (const frame of this.frames.values()) frame.remove()
      this.frames.clear()
      this.dataset.activeEffects = ''
    }

    private readSources(): VendorSources | null {
      try {
        const parsed: unknown = JSON.parse(this.dataset.sources ?? '')
        if (!parsed || typeof parsed !== 'object') return null

        const candidate = parsed as Partial<VendorSources>
        const required: Array<keyof VendorSources> = [
          'georgeAnime',
          'georgeFireworks',
          'georgeSakura',
          'georgeTinycolor',
          'pkuFlutter',
          'pkuNest',
          'pkuRibbon'
        ]
        if (
          required.some(
            (key) => typeof candidate[key] !== 'string' || !candidate[key]?.startsWith('/')
          )
        )
          return null

        return candidate as VendorSources
      } catch {
        return null
      }
    }

    private policy(): EffectPolicy {
      return {
        click: this.dataset.click === 'true',
        petals: this.dataset.petals === 'true',
        pkuBackdrop: this.dataset.pkuBackdrop === 'true'
      }
    }

    private sync = () => {
      if (!this.isConnected || !this.sources) return

      const effectsDisabled = document.documentElement.dataset.decorativeEffects === 'off'
      const paused =
        effectsDisabled ||
        document.visibilityState !== 'visible' ||
        this.motionQuery?.matches === true

      if (paused) {
        this.stopFrames()
        this.dataset.lifecycle = effectsDisabled
          ? 'disabled'
          : this.motionQuery?.matches
            ? 'reduced'
            : 'paused'
        return
      }

      const policy = this.policy()
      const desired = new Set<EffectKind>()
      if (policy.pkuBackdrop && !this.pkuMobileMedia?.matches) desired.add('pku')
      if (policy.petals) desired.add('petals')
      if (policy.click) desired.add('click')

      for (const kind of effectKinds) {
        if (desired.has(kind)) this.ensureFrame(kind)
        else this.removeFrame(kind)
      }

      this.syncClickForwarder(desired.has('click'))
      this.syncPkuForwarder(desired.has('pku'))
      this.dataset.activeEffects = effectKinds.filter((kind) => desired.has(kind)).join(',')
      this.dataset.lifecycle = desired.size > 0 ? 'active' : 'disabled'
    }

    private ensureFrame(kind: EffectKind) {
      if (this.frames.has(kind) || !this.sources) return

      const frame = document.createElement('iframe')
      frame.className = 'visual-effects-frame'
      frame.dataset.effectFrame = kind
      frame.dataset.ready = 'false'
      frame.setAttribute('aria-hidden', 'true')
      frame.setAttribute('tabindex', '-1')
      frame.setAttribute('title', '')
      frame.referrerPolicy = 'no-referrer'
      frame.srcdoc = this.sourceDocument(kind, this.sources)
      frame.addEventListener(
        'load',
        () => {
          if (!this.frames.has(kind) || !frame.isConnected) return
          frame.dataset.ready = 'true'
        },
        { once: true }
      )
      this.frames.set(kind, frame)
      this.append(frame)
    }

    private removeFrame(kind: EffectKind) {
      const frame = this.frames.get(kind)
      if (!frame) return
      frame.remove()
      this.frames.delete(kind)
      if (kind === 'click') this.stopClickForwarder()
      if (kind === 'pku') this.stopPkuForwarder()
    }

    private syncClickForwarder(enabled: boolean) {
      if (!enabled || !this.frames.has('click')) {
        this.stopClickForwarder()
        return
      }
      if (this.clickController) return

      this.clickController = new AbortController()
      document.addEventListener('mousedown', this.forwardBlankClick, {
        capture: true,
        signal: this.clickController.signal
      })
    }

    private stopClickForwarder() {
      this.clickController?.abort()
      this.clickController = null
    }

    private syncPkuForwarder(enabled: boolean) {
      if (!enabled || !this.frames.has('pku')) {
        this.stopPkuForwarder()
        return
      }
      if (this.pkuController) return

      this.pkuController = new AbortController()
      const { signal } = this.pkuController
      this.pkuScrollY = window.scrollY
      document.addEventListener('mousemove', this.forwardPkuPointer, { passive: true, signal })
      window.addEventListener('mouseout', this.forwardPkuMouseOut, { passive: true, signal })
      window.addEventListener('scroll', this.forwardPkuScroll, { passive: true, signal })
      this.schedulePkuMessage()
    }

    private stopPkuForwarder() {
      this.pkuController?.abort()
      this.pkuController = null
      if (this.pkuMessageFrame) cancelAnimationFrame(this.pkuMessageFrame)
      this.pkuMessageFrame = 0
      this.pkuPointer = null
      this.pkuPointerOutside = false
    }

    private forwardPkuPointer = (event: MouseEvent) => {
      this.pkuPointer = { x: event.clientX, y: event.clientY }
      this.schedulePkuMessage()
    }

    private forwardPkuScroll = () => {
      this.pkuScrollY = window.scrollY
      this.schedulePkuMessage()
    }

    private forwardPkuMouseOut = (event: MouseEvent) => {
      // Only relay an actual departure from the viewport, not every movement
      // between descendants in the page shell.
      if (event.relatedTarget) return
      this.pkuPointerOutside = true
      this.schedulePkuMessage()
    }

    private schedulePkuMessage() {
      if (this.pkuMessageFrame || !this.frames.has('pku')) return
      this.pkuMessageFrame = requestAnimationFrame(() => {
        this.pkuMessageFrame = 0
        const frame = this.frames.get('pku')
        if (!frame) return
        if (this.pkuPointer) {
          frame.contentWindow?.postMessage(
            { type: 'susurrium:pku-pointer', x: this.pkuPointer.x, y: this.pkuPointer.y },
            '*'
          )
          this.pkuPointer = null
        }
        if (this.pkuPointerOutside) {
          frame.contentWindow?.postMessage({ type: 'susurrium:pku-pointer-out' }, '*')
          this.pkuPointerOutside = false
        }
        frame.contentWindow?.postMessage({ type: 'susurrium:pku-scroll', y: this.pkuScrollY }, '*')
      })
    }

    private forwardBlankClick = (event: MouseEvent) => {
      if (event.button !== 0 || !this.isBlankClick(event)) return
      const frame = this.frames.get('click')
      if (!frame || frame.dataset.ready !== 'true') return

      frame.contentWindow?.postMessage(
        { type: 'susurrium:george-fireworks', x: event.clientX, y: event.clientY },
        '*'
      )
      this.dataset.clickBurstCount = String(Number(this.dataset.clickBurstCount ?? '0') + 1)
    }

    private isBlankClick(event: MouseEvent) {
      if (!(event.target instanceof Element)) return false
      const selection = window.getSelection()
      if (selection && !selection.isCollapsed) return false

      const target = event.target
      const interactive = target.closest(
        [
          'a',
          'button',
          'input',
          'textarea',
          'select',
          'option',
          'label',
          'summary',
          'details',
          'audio',
          'video',
          'iframe',
          'canvas',
          '[role="button"]',
          '[role="link"]',
          '[contenteditable]',
          '[data-no-click-burst]',
          '[data-click-burst-interactive]',
          'header-component',
          'music-player',
          'footer',
          'article',
          'aside',
          '.prose',
          '[class*="card"]',
          'p',
          'h1',
          'h2',
          'h3',
          'h4',
          'h5',
          'h6',
          'blockquote',
          'pre',
          'code',
          'table',
          'ul',
          'ol',
          'li',
          'dl',
          'dt',
          'dd',
          'figure',
          'figcaption',
          'picture',
          'img',
          'svg',
          'time'
        ].join(',')
      )
      return (
        !interactive &&
        (target === document.body ||
          target === document.documentElement ||
          Boolean(target.closest('[data-click-burst-zone]')))
      )
    }

    private sourceDocument(kind: EffectKind, sources: VendorSources) {
      const closeScript = '</scr' + 'ipt>'
      const escapeAttribute = (value: string) =>
        value.replaceAll('&', '&amp;').replaceAll('"', '&quot;').replaceAll('<', '&lt;')
      const script = (source: string, id?: string, attributes = '') =>
        `<script${id ? ` id="${id}"` : ''}${attributes} src="${escapeAttribute(source)}">${closeScript}`
      const documentStart = `<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><style>html,body{width:100%;height:100%;margin:0;overflow:hidden;background:transparent}canvas{pointer-events:none}</style></head><body>`
      const documentEnd = '</body></html>'

      if (kind === 'pku') {
        // The scripts themselves are unchanged. The only adaptation is their
        // z order inside this isolated frame, preserving the original three
        // layers while keeping all of them beneath site content.
        const labelLastCanvas = (layer: string, zIndex: number) =>
          `<script>(()=>{const canvas=document.body.querySelector('canvas:last-of-type');if(canvas){canvas.dataset.pkuLayer='${layer}';canvas.style.zIndex='${zIndex}'}})()${closeScript}`
        const relay = `<script>(()=>{let pageY=0;try{Object.defineProperty(window,'pageYOffset',{configurable:true,get:()=>pageY})}catch{}window.addEventListener('message',event=>{const data=event.data;if(event.source!==parent||!data)return;if(data.type==='susurrium:pku-pointer'&&Number.isFinite(data.x)&&Number.isFinite(data.y)){window.dispatchEvent(new MouseEvent('mousemove',{clientX:data.x,clientY:data.y}))}if(data.type==='susurrium:pku-pointer-out'){window.dispatchEvent(new MouseEvent('mouseout'))}if(data.type==='susurrium:pku-scroll'&&Number.isFinite(data.y)){pageY=Math.max(0,data.y);window.dispatchEvent(new Event('scroll'))}})})()${closeScript}`
        return `${documentStart}${relay}${script(sources.pkuRibbon, 'ribbon', ' mobile="false" zIndex="-1" alpha="0.6" size="150" data-click="false"')}${labelLastCanvas('ribbon', 1)}${script(sources.pkuFlutter, 'fluttering_ribbon', ' mobile="false"')}${labelLastCanvas('flutter', 2)}${script(sources.pkuNest, 'canvas_nest', ' mobile="false" zIndex="-1" color="0,0,255" opacity="0.7" count="99"')}${labelLastCanvas('nest', 3)}${documentEnd}`
      }

      if (kind === 'petals') {
        // `GEORGE-SAKURA` creates its original fifty sprite petals itself.
        return `${documentStart}${script(sources.georgeSakura)}${documentEnd}`
      }

      // `GEORGE-CLICK` stays byte-for-byte intact. The parent owns the
      // permitted-target filter, then relays an accepted coordinate as a
      // synthetic iframe mousedown so the original 20 particles + ring draw.
      const relay = `<script>window.addEventListener('message',event=>{const data=event.data;if(event.source!==parent||!data||data.type!=='susurrium:george-fireworks'||!Number.isFinite(data.x)||!Number.isFinite(data.y))return;document.dispatchEvent(new MouseEvent('mousedown',{bubbles:true,clientX:data.x,clientY:data.y,button:0}))})${closeScript}`
      return `${documentStart}<canvas class="fireworks" aria-hidden="true"></canvas><style>canvas.fireworks{position:fixed;inset:0;width:100%;height:100%;pointer-events:none}</style>${script(sources.georgeTinycolor)}${script(sources.georgeAnime)}${script(sources.georgeFireworks)}${relay}${documentEnd}`
    }
  }

  if (!customElements.get('visual-effects-host')) {
    customElements.define('visual-effects-host', VisualEffectsHostElement)
  }
</script>

<style is:global>
  visual-effects-host {
    display: contents;
    pointer-events: none;
  }

  visual-effects-host > .visual-effects-frame {
    position: fixed;
    inset: 0;
    display: block;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    border: 0;
    background: transparent;
    pointer-events: none;
  }

  visual-effects-host > .visual-effects-frame[data-effect-frame='pku'] {
    z-index: var(--z-page-effects);
  }

  visual-effects-host > .visual-effects-frame[data-effect-frame='petals'] {
    z-index: var(--z-petals);
  }

  visual-effects-host > .visual-effects-frame[data-effect-frame='click'] {
    z-index: var(--z-click);
  }
</style>
