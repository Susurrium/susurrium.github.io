---
import type { IconsType } from 'astro-pure/types'
import { Icon } from 'astro-pure/user'

interface SubstatsItem {
  platform: string
  icon: IconsType
  color?: string
  link?: string
  text: string
  count?: number
}

type Props = {
  stats: SubstatsItem[]
}

const { stats } = Astro.props as Props
---

<div
  class='site-card-surface grid grid-cols-1 gap-3 rounded-xl border p-2 sm:grid-cols-2 sm:p-3'
  data-card-surface='standard'
>
  {
    stats.map(({ link, platform, icon, color, count, text }) => (
      <a
        class='group text-muted-foreground no-underline'
        href={link}
        target='_blank'
        rel='noopener noreferrer'
      >
        <div class='flex items-center gap-3 rounded-lg border border-transparent px-3 py-2 transition-all hover:border-border hover:bg-muted focus-within:border-border focus-within:bg-muted'>
          {icon && <Icon name={icon} color={color} />}
          <div class='flex-1 text-foreground transition-colors group-hover:text-primary group-focus-within:text-primary'>
            {platform}
          </div>
          {typeof count === 'number' ? (
            <div class='flex items-center gap-1.5'>
              <samp>{count}</samp>
              <span class='text-sm font-normal'>{text}</span>
            </div>
          ) : null}
        </div>
      </a>
    ))
  }
</div>
<div class='mt-2 text-right text-sm'>External statistics are disabled during development.</div>
