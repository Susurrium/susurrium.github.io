---
/**
 * HAN-HEATMAP's compact 53-week GitHub contribution presentation.
 * DOM, levels, labels and interaction follow the locked source; only the
 * username and local theme-token bridge belong to this project.
 */
import {
  createGitHubContributionHeatmapSkeleton,
  getGitHubContributionHeatmap
} from '@/data/github-contributions'
import '@/assets/styles/github-contribution-heatmap.css'

interface Props {
  class?: string
  username?: string
}

const { class: className, username = 'Susurrium' } = Astro.props
const normalizedUsername = username.trim()
const fetchedHeatmap = normalizedUsername ? await getGitHubContributionHeatmap(normalizedUsername) : null
const heatmap = fetchedHeatmap ?? createGitHubContributionHeatmapSkeleton()
const profileHref = `https://github.com/${encodeURIComponent(normalizedUsername)}`
const contributionSummary = fetchedHeatmap && heatmap.total > 0
  ? `${heatmap.total.toLocaleString('en-US')} contributions in the last year`
  : 'GitHub contribution heatmap'
const compactContributionCount = fetchedHeatmap && heatmap.total > 0
  ? `${Intl.NumberFormat('en-US', { maximumFractionDigits: 1, notation: 'compact' })
      .format(heatmap.total)
      .toLowerCase()} contributions`
  : 'contributions'
const heatmapStyle = `--githeatmap-week-count: ${heatmap.weekCount};`
const legendLevels = [0, 1, 2, 3, 4]
const heatmapWeeks = Array.from({ length: Math.ceil(heatmap.days.length / 7) }, (_, weekIndex) => ({
  days: heatmap.days.slice(weekIndex * 7, weekIndex * 7 + 7),
  hoverDelay: `${weekIndex * 10}ms`
}))
---

{
  normalizedUsername && (
    <a
      class:list={['githeatmap-link', className]}
      data-githeatmap-state={fetchedHeatmap ? 'ready' : 'fallback'}
      href={profileHref}
      target='_blank'
      rel='noopener noreferrer'
      style={heatmapStyle}
      aria-label={`View ${normalizedUsername}'s GitHub profile: ${contributionSummary}`}
    >
      <span class='githeatmap-summary'>{contributionSummary}</span>
      <div class='githeatmap-calendar' aria-hidden='true'>
        <div class='githeatmap-months'>
          {heatmap.months.map((month) => (
            <span class='githeatmap-month' style={`grid-column: ${month.weekIndex + 1};`}>
              {month.label}
            </span>
          ))}
        </div>
        <div class='githeatmap-grid'>
          {heatmapWeeks.map((week) => (
            <span class='githeatmap-week' style={`--githeatmap-hover-delay: ${week.hoverDelay};`}>
              {week.days.map((day) => (
                <span
                  class='githeatmap-cell'
                  data-level={day.level}
                  data-blank={day.isBlank ? 'true' : undefined}
                  title={day.label || undefined}
                />
              ))}
            </span>
          ))}
        </div>
      </div>
      <div class='githeatmap-footer' aria-hidden='true'>
        <span class='githeatmap-count'>{compactContributionCount}</span>
        <span class='githeatmap-legend'>
          <span class='githeatmap-legend-label'>Less</span>
          <span class='githeatmap-legend-scale'>
            {legendLevels.map((level) => (
              <span class='githeatmap-legend-cell' data-level={level} />
            ))}
          </span>
          <span class='githeatmap-legend-label'>More</span>
        </span>
      </div>
    </a>
  )
}
