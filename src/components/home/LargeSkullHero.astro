---
/**
 * Visual source: LargeSkull/LargeSkull.github.io@9599a54f23cdfc4606f2f5edc07e8138e050205b
 * (`index.html:54-113`, `css/app.css:2076-2250`, `2419-2485`).
 *
 * The original fixed image layer used z-index -9. The surrounding Pure body
 * paints an opaque background, so this Astro integration keeps the same fixed
 * geometry at z-index 0 and places all readable Home sections above it.
 */
import { heroSlides } from '@/data/home-media'
import config from '@/site-config'
---

<section class='large-skull-hero' data-home-hero>
  <div class='large-skull-hero__media' aria-hidden='true' data-home-hero-media>
    {
      heroSlides.map((slide, index) => (
        <div
          class='large-skull-hero__slide'
          data-slide-index={index}
          data-slide-key={slide.key}
          style={`background-image:url(${slide.src})`}
          title={slide.description}
        />
      ))
    }
  </div>

  <div class='large-skull-hero__stage'>
    <div class='large-skull-hero__brand' data-home-hero-brand>
      <div class='large-skull-hero__brand-pjax'>
        <a class='large-skull-hero__logo' href='/home' rel='start'>
          <p class='large-skull-hero__artboard'>{config.author}</p>
          <h1 class='large-skull-hero__title'>{config.title}</h1>
        </a>
        <p class='large-skull-hero__meta'>= {config.description} =</p>
      </div>
    </div>
  </div>

  <div class='large-skull-hero__waves' data-home-waves>
    <svg
      class='large-skull-hero__wave-svg'
      xmlns='http://www.w3.org/2000/svg'
      viewBox='0 24 150 28'
      preserveAspectRatio='none'
      shape-rendering='auto'
    >
      <defs>
        <path id='gentle-wave' d='M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z' />
      </defs>
      <g class='large-skull-hero__parallax'>
        <use href='#gentle-wave' x='48' y='0' />
        <use href='#gentle-wave' x='48' y='3' />
        <use href='#gentle-wave' x='48' y='5' />
        <use href='#gentle-wave' x='48' y='7' />
      </g>
    </svg>
  </div>
</section>

<style>
  .large-skull-hero {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    color: #fff;
    text-shadow: 0 0.2rem 0.3rem rgb(0 0 0 / 0.5);
  }

  .large-skull-hero__media {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 0;
    width: 100%;
    height: 70vh;
    min-height: 25rem;
    overflow: hidden;
    background-color: #363636;
    pointer-events: none;
  }

  .large-skull-hero__media::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    background-color: rgb(0 0 0 / 0.2);
    content: '';
    transition: all 0.2s ease-in-out 0s;
  }

  :global(.dark) .large-skull-hero__media::before {
    background-color: rgb(0 0 0 / 0.5);
  }

  .large-skull-hero__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-position: 50% 50%;
    background-repeat: no-repeat;
    background-size: cover;
    opacity: 0;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    animation: large-skull-image-animation 36s linear infinite 0s;
  }

  .large-skull-hero__slide:nth-child(2) {
    animation-delay: 6s;
  }

  .large-skull-hero__slide:nth-child(3) {
    animation-delay: 12s;
  }

  .large-skull-hero__slide:nth-child(4) {
    animation-delay: 18s;
  }

  .large-skull-hero__slide:nth-child(5) {
    animation-delay: 24s;
  }

  .large-skull-hero__slide:nth-child(6) {
    animation-delay: 30s;
  }

  .large-skull-hero__stage {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    height: 50vh;
    padding: 3rem 5rem 0;
    align-items: center;
    justify-content: center;
  }

  .large-skull-hero__brand {
    min-height: 10rem;
    max-width: min(42rem, 100%);
    text-align: center;
  }

  .large-skull-hero__brand,
  .large-skull-hero__brand-pjax {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .large-skull-hero__logo {
    color: inherit;
    text-decoration: none;
  }

  /* Direct LargeSkull `#brand` typography: artboard → title → meta. */
  .large-skull-hero__artboard {
    margin: 0;
    font-family: 'Fredericka the Great', 'Times New Roman', serif;
    font-size: 3.5em;
    line-height: 1.2;
  }

  .large-skull-hero__title {
    margin: 0.625rem 0;
    font-size: 2.5em;
    font-weight: 700;
    letter-spacing: 0.125rem;
  }

  .large-skull-hero__meta {
    display: flex;
    margin: 0;
    font-size: 0.875em;
  }

  .large-skull-hero__waves {
    position: relative;
    z-index: 1;
    margin-bottom: -0.6875rem;
  }

  .large-skull-hero__wave-svg {
    position: relative;
    display: block;
    width: 100%;
    height: 15vh;
    min-height: 3.125rem;
    max-height: 9.375rem;
  }

  .large-skull-hero__parallax > use {
    animation: large-skull-wave 25s cubic-bezier(0.55, 0.5, 0.45, 0.5) infinite;
  }

  .large-skull-hero__parallax > use:nth-child(1) {
    fill: hsl(var(--background) / 0.7);
    animation-delay: -2s;
    animation-duration: 7s;
  }

  .large-skull-hero__parallax > use:nth-child(2) {
    fill: hsl(var(--background) / 0.5);
    animation-delay: -3s;
    animation-duration: 10s;
  }

  .large-skull-hero__parallax > use:nth-child(3) {
    fill: hsl(var(--background) / 0.3);
    animation-delay: -4s;
    animation-duration: 13s;
  }

  .large-skull-hero__parallax > use:nth-child(4) {
    fill: hsl(var(--background));
    animation-delay: -5s;
    animation-duration: 20s;
  }

  @keyframes large-skull-image-animation {
    0% {
      opacity: 0;
      transform: scale(1);
      animation-timing-function: ease-in;
    }

    2% {
      opacity: 1;
    }

    8% {
      opacity: 1;
      transform: scale(1.05);
      animation-timing-function: ease-out;
    }

    17% {
      opacity: 1;
      transform: scale(1.1);
    }

    25% {
      opacity: 0;
      transform: scale(1.1);
    }

    100% {
      opacity: 0;
    }
  }

  @keyframes large-skull-wave {
    0% {
      transform: translate3d(-90px, 0, 0);
    }

    100% {
      transform: translate3d(85px, 0, 0);
    }
  }

  @media (max-width: 767px) {
    .large-skull-hero__stage {
      padding-inline: 0.5rem;
    }

    .large-skull-hero__title {
      font-size: 1.5em;
    }

    .large-skull-hero__meta {
      font-size: 0.75em;
    }

    .large-skull-hero__wave-svg {
      height: 10vh;
    }
  }

  @media (max-width: 413px) {
    .large-skull-hero__artboard {
      font-size: 2.5em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .large-skull-hero__slide,
    .large-skull-hero__parallax > use {
      animation: none;
    }

    .large-skull-hero__slide {
      opacity: 0;
    }

    .large-skull-hero__slide:first-child {
      opacity: 1;
    }
  }
</style>
