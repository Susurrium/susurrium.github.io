---
const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '')
const asset = (path: string) => `${basePath}${path}`
---

<div
  class="residence-flight residence-flight--plane"
  data-flight-layer
  data-flight-motion="plane"
  aria-hidden="true"
>
  <img
    class="residence-flight__shadow residence-flight__shadow--plane"
    data-plane-shadow
    src={asset('/media/residence/skywt-plane-shadow.png')}
    alt=""
    width="60"
    height="60"
    loading="lazy"
    decoding="async"
    draggable="false"
  />
  <img
    class="residence-flight__image residence-flight__image--plane"
    data-plane
    src={asset('/media/residence/skywt-plane.png')}
    alt=""
    width="81"
    height="188"
    loading="lazy"
    decoding="async"
    draggable="false"
  />
</div>

<div
  class="residence-flight residence-flight--cloud"
  data-flight-layer
  data-flight-motion="cloud"
  aria-hidden="true"
>
  <img
    class="residence-flight__shadow residence-flight__shadow--cloud"
    data-cloud-shadow
    src={asset('/media/residence/skywt-cloud.png')}
    alt=""
    width="1746"
    height="1554"
    loading="lazy"
    decoding="async"
    draggable="false"
  />
  <img
    class="residence-flight__image residence-flight__image--cloud"
    data-cloud
    src={asset('/media/residence/skywt-cloud.png')}
    alt=""
    width="1746"
    height="1554"
    loading="lazy"
    decoding="async"
    draggable="false"
  />
</div>
