---
import { isContentSurfaceEnabled } from '@/lib/content-layer/policy'
import type { RenderablePageItem } from '@/lib/content-layer/types'
import { homeSayingItems, homeSayingPreview } from '@/lib/home/saying-catalog'

import { Button } from 'astro-pure/user'
import ContentCard from '@/components/cards/ContentCard.astro'

interface Props {
  items: readonly RenderablePageItem[]
}

const sayingItems = homeSayingItems(Astro.props.items)
const fallbackItem = sayingItems[0]
---

{
  fallbackItem && (
    <section
      class='home-random-saying'
      aria-labelledby='home-random-saying-heading'
      data-home-random-saying
    >
      <h2 id='home-random-saying-heading' class='sr-only'>
        Saying
      </h2>
      <saying-random-card data-random-saying aria-busy='true'>
        <div class='home-random-saying__placeholder' aria-hidden='true' />
      </saying-random-card>
      {sayingItems.map((item) => (
        <template
          id={`home-saying-template-${item.record.id}`}
          data-saying-template={item.record.id}
        >
          <ContentCard
            class='home-saying-card'
            item={item}
            preview={homeSayingPreview(item)}
            imageLoading='eager'
          />
          <button type='button' class='home-random-saying__retry' data-saying-image-retry hidden>
            图片加载失败，点击重试
          </button>
        </template>
      ))}
      <script is:inline data-home-saying-mount>
        window.__susurriumSaying.mount(document)
      </script>
      <noscript>
        <style is:inline set:html={'saying-random-card { display: none !important; }'} />
        <ContentCard class='home-saying-card' item={fallbackItem} />
      </noscript>
      {isContentSurfaceEnabled('saying', 'archive') && (
        <div class='home-random-saying__actions' data-home-saying-actions>
          <Button
            title='View all'
            href='/sayings'
            variant='ahead'
            aria-label='View all Sayings'
            data-home-action='ahead'
            class='home-random-saying__more w-fit self-end'
          />
        </div>
      )}
    </section>
  )
}

<style>
  .home-random-saying {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.9rem;
  }

  .home-random-saying__actions {
    display: flex;
    width: 100%;
    justify-content: flex-end;
  }

  saying-random-card {
    display: block;
  }

  .home-random-saying__placeholder {
    height: 14rem;
    margin-block: 1rem;
  }

  @media (max-width: 767px) {
    .home-random-saying__placeholder {
      height: 28rem;
    }
  }

  .home-random-saying :global(.home-random-saying__retry) {
    margin-top: 0.25rem;
    color: hsl(var(--primary));
    text-decoration: underline;
  }

  .home-random-saying :global(.home-random-saying__retry[hidden]) {
    display: none;
  }

  .home-random-saying :global(.media-card.home-saying-card) {
    box-sizing: border-box;
    width: 100%;
    min-width: 100%;
    margin-inline: 0;
  }
</style>
