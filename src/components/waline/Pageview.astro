---
// https://waline.js.org/en/guide/features/pageview.html#use-alone
import config from '@/site-config'
---

<script
  is:inline
  type='module'
  data-astro-rerun
  define:vars={{ npmCDN: config.npmCDN, walineServer: config.integ.waline.server }}
>
  async function loadPageview() {
    try {
      const pageview = await import(`${npmCDN}/@waline/client@v3/dist/pageview.js`)
      const el = document.querySelector('.waline-pageview-count')
      if (el) {
        // PageInfo exposes the canonical path used by comments and counts.
        // Keep a defensive fallback for standalone use of this component.
        const rawPath = el.getAttribute('data-path') || window.location.pathname
        const path = rawPath === '/' ? '/' : rawPath.replace(/\/+$/, '') || '/'
        pageview.pageviewCount({
          serverURL: walineServer,
          path
        })
      }
    } catch (e) {
      console.error('Failed to load Waline pageview:', e)
    }
  }

  // Waline's `pageviewCount` does not return a cancellation function.  Start
  // the optional request without manufacturing an `abort()` call; PageInfo
  // only renders this component when the integration has explicitly been
  // enabled with a reviewed server configuration.
  void loadPageview()
</script>
