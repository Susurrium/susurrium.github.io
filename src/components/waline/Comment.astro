---
import { normalizeWalinePath } from '@/lib/waline-path'

import { cn } from 'astro-pure/utils'
import config from '@/site-config'

const { class: className } = Astro.props
---

{
  config.integ.waline.enable && (
    <comment-component
      data-waline-path={normalizeWalinePath(Astro.url.pathname)}
      data-comment-state='idle'
    >
      <div
        id='waline'
        class={cn('not-prose', config.integ.waline.showMeta === false && 'hide-meta', className)}
      >
        <p data-comment-status role='status'>
          评论尚未加载。
        </p>
        <button type='button' data-comment-load disabled>
          加载评论
        </button>
        <noscript>
          <p>启用 JavaScript 后可加载评论。</p>
        </noscript>
      </div>
    </comment-component>
  )
}

<script>
  import { loadBrowserResource } from '@/lib/client/resources'
  import type { WalineEmojiPresets, WalineInstance } from '@waline/client'
  import walineStyleUrl from '@waline/client/style?url'
  import config from 'virtual:config'

  const walineConfig = config.integ.waline

  class Comment extends HTMLElement {
    private instance: WalineInstance | null = null
    private controller?: AbortController
    private observer?: IntersectionObserver
    private generation = 0
    private loading = false

    connectedCallback() {
      this.disconnectedCallback()
      this.controller = new AbortController()
      const { signal } = this.controller
      this.dataset.commentState = 'idle'
      const trigger = this.querySelector<HTMLButtonElement>('[data-comment-load]')
      if (trigger) trigger.disabled = false
      this.querySelector('[data-comment-load]')?.addEventListener('click', this.load, { signal })
      this.addEventListener('focusin', this.load, { signal })
      const checkHash = () => {
        if (location.hash === '#waline' && this.dataset.commentState === 'idle') void this.load()
      }
      window.addEventListener('hashchange', checkHash, { signal })
      document.addEventListener('astro:page-load', checkHash, { signal })
      this.observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting && this.dataset.commentState === 'idle') void this.load()
        },
        { rootMargin: '320px 0px' }
      )
      this.observer.observe(this)
      checkHash()
    }

    private load = async () => {
      if (this.instance || this.loading || !this.isConnected) return
      const container = this.querySelector<HTMLElement>('#waline')
      if (!container) return
      this.loading = true
      this.dataset.commentState = 'loading'
      const generation = this.generation
      const status = this.querySelector<HTMLElement>('[data-comment-status]')
      const button = this.querySelector<HTMLButtonElement>('[data-comment-load]')
      if (status) status.textContent = '正在加载评论…'
      if (button) button.disabled = true
      // Prevent Vue log errors
      ;(globalThis as unknown as { __VUE_OPTIONS_API__: boolean }).__VUE_OPTIONS_API__ = true
      ;(globalThis as unknown as { __VUE_PROD_DEVTOOLS__: boolean }).__VUE_PROD_DEVTOOLS__ = false
      ;(
        globalThis as unknown as { __VUE_PROD_HYDRATION_MISMATCH_DETAILS__: boolean }
      ).__VUE_PROD_HYDRATION_MISMATCH_DETAILS__ = false

      try {
        const [{ init: walineInit }] = await Promise.all([
          import('@waline/client'),
          loadBrowserResource(walineStyleUrl, 'stylesheet', 'waline-client-style')
        ])
        if (generation !== this.generation || !this.isConnected) return
        const emoji = walineConfig.emoji?.map(
          (preset) => `${config.npmCDN}/@waline/emojis@1.2.0/${preset}` as WalineEmojiPresets
        )
        const path = this.dataset.walinePath || window.location.pathname.replace(/\/+$/, '') || '/'

        this.instance = walineInit({
          el: container,
          serverURL: walineConfig.server || '',
          emoji,
          reaction: ['/icons/heart-item.svg'],
          ...walineConfig.additionalConfigs,
          pageview: false,
          comment: false,
          path
        })
        this.observer?.disconnect()
        this.dataset.commentState = 'ready'
      } catch (error) {
        if (generation !== this.generation || !this.isConnected) return
        console.error('Unable to load Waline comments.', error)
        this.dataset.commentState = 'error'
        if (status) status.textContent = '评论加载失败，请重试。'
        if (button) {
          button.disabled = false
          button.textContent = '重新加载评论'
        }
      } finally {
        if (generation === this.generation) this.loading = false
      }
    }

    disconnectedCallback() {
      this.controller?.abort()
      this.observer?.disconnect()
      this.generation++
      this.loading = false
      this.instance?.destroy()
      this.instance = null
    }
  }

  if (walineConfig.enable && !customElements.get('comment-component'))
    customElements.define('comment-component', Comment)
</script>

<style>
  comment-component {
    display: block;
    min-height: 18rem;
  }
  [data-comment-load] {
    margin-top: 0.5rem;
    text-decoration: underline;
  }
  /* Basic theme */
  #waline {
    /* Font size */
    --waline-font-size: 16px;
    /* Basic color */
    --waline-white: hsl(var(--background) / var(--un-bg-opacity, 1));
    --waline-light-grey: #999;
    --waline-dark-grey: #666;
    /* Theme color */
    --waline-theme-color: hsl(var(--foreground) / var(--un-text-opacity, 1));
    --waline-active-color: hsl(var(--primary) / var(--un-text-opacity, 1));
    /* Layout */
    --waline-color: hsl(var(--muted-foreground) / var(--un-text-opacity, 1));
    --waline-bg-color: hsl(var(--muted) / var(--un-bg-opacity, 1));
    --waline-bg-color-light: hsl(var(--input) / var(--un-text-opacity, 1));
    --waline-bg-color-hover: #f0f0f0;
    --waline-border-color: hsl(var(--border) / var(--un-border-opacity, 1));
    --waline-disable-bg-color: #f8f8f8;
    --waline-disable-color: #bbb;
    --waline-code-bg-color: #282c34;
    /* Special */
    --waline-bq-color: #f0f0f0;
    /* Avatar */
    --waline-avatar-size: 3.25rem;
    --waline-m-avatar-size: calc(var(--waline-avatar-size) * 9 / 13);
    /* Badge */
    --waline-badge-color: hsl(var(--border) / var(--un-border-opacity, 1));
    --waline-badge-font-size: 0.775em;
    /* Info */
    --waline-info-bg-color: var(--waline-bg-color-light);
    --waline-info-color: var(--waline-color);
    --waline-info-font-size: 0.625em;
    /* Render selection */
    --waline-border: 1px solid var(--waline-border-color);
    --waline-avatar-radius: 50%;
    --waline-box-shadow: none;
  }

  /* Fix long text and links overflow */
  #waline :global(.wl-content, .wl-text, .wl-comment-text) {
    word-wrap: break-word;
    word-break: break-word;
    overflow-wrap: anywhere;
    max-width: 100%;
  }

  #waline :global(.wl-content a, .wl-text a, .wl-comment-text a) {
    word-wrap: break-word;
    word-break: break-word;
    overflow-wrap: anywhere;
    max-width: 100%;
  }

  #waline :global(.wl-item, .wl-card-item) {
    max-width: 100%;
    overflow: hidden;
  }

  #waline :global(.wl-meta) {
    word-wrap: break-word;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  #waline.hide-meta :global(.wl-meta) {
    display: none;
  }

  /* Reaction buttons */
  #waline :global(.wl-reaction-title, .wl-reaction-text) {
    display: none;
  }
  #waline :global(.wl-reaction) {
    overflow: visible;
    margin-bottom: 0.5em;
  }
  #waline :global(.wl-reaction-img) {
    width: auto;
    display: flex;
    height: 35px;
    align-items: center;
    column-gap: 0.4rem;
  }
  #waline :global(.wl-reaction-votes) {
    position: inherit;
    top: inherit;
    min-width: inherit;
    inset-inline-end: inherit;
    display: flex;
    font-weight: normal;
    border: none;
    background: none;
    color: inherit;
    padding: 0.2rem 0.4rem;
    border-radius: 6px;
  }
  #waline :global(.wl-reaction-loading) {
    position: inherit;
    top: inherit;
    min-width: inherit;
  }
  #waline :global(.wl-reaction-item.active .wl-reaction-votes) {
    background: var(--waline-theme-color);
    color: var(--waline-bg-color);
  }

  #waline :global(.wl-reaction-votes:after) {
    margin-left: 0.25em;
    content: 'Like(s)';
    display: inline-block;
    clear: both;
    border: 0;
  }
  #waline :global(.wl-reaction img) {
    filter: invert(25%);
  }
  :global(.dark) #waline :global(.wl-reaction img) {
    filter: invert(75%);
  }
</style>
