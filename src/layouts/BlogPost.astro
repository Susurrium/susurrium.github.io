---
/** Compatibility route layout; the actual composition lives in ContentReadingPage. */
import type { MarkdownHeading } from 'astro'
import type {
  ReadingPageConfig,
  ReadingPageConfigOverride,
  RenderablePageItem
} from '@/lib/content-layer'

import ContentReadingPage from './ContentReadingPage.astro'

interface Props {
  item: Extract<RenderablePageItem, { record: { kind: 'blog' } }>
  relatedItems: readonly RenderablePageItem[]
  headings: MarkdownHeading[]
  /** Optional one-page composition override; baseline remains resolved centrally. */
  readingConfig?: ReadingPageConfig
  readingOverride?: ReadingPageConfigOverride
  remarkPluginFrontmatter: Record<string, unknown>
}

const { headings, item, readingConfig, readingOverride, relatedItems, remarkPluginFrontmatter } =
  Astro.props as Props
---

<ContentReadingPage
  {headings}
  {item}
  pageKind='blog-detail'
  {readingConfig}
  {readingOverride}
  {relatedItems}
  {remarkPluginFrontmatter}
>
  <slot />
  <Fragment slot='bottom-sidebar'>
    <slot name='bottom-sidebar' />
  </Fragment>
</ContentReadingPage>
