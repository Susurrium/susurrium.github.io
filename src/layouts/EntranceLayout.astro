---
import '@/assets/styles/app.css'

import { entrance } from '@/data/entrance'

import config from '@/site-config'

interface Props {
  title?: string
}

const { title = `Enter ${entrance.title}` } = Astro.props
const canonicalHome = new URL('/home', Astro.site)
---

<!doctype html>
<html lang={config.locale.lang}>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0, shrink-to-fit=no' />
    <meta name='robots' content='noindex, follow' />
    <link rel='canonical' href={canonicalHome} />
    <title>{title}</title>
  </head>
  <body class='min-h-[100dvh] bg-background text-foreground' data-page-kind='entrance'>
    <slot />
  </body>
</html>
