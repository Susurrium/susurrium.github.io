---
import '@/assets/styles/app.css'

import { prod } from 'astro-pure/server'
import { entrance } from '@/data/entrance'

import config from '@/site-config'

interface Props {
  title?: string
}

const { title = `Enter ${entrance.title}` } = Astro.props
const canonicalHome = new URL('/home', Astro.site)
const umamiScriptUrl = 'https://cloud.umami.is/script.js'
const umamiWebsiteId = '99c69339-dfd3-42e5-8def-5a6877712e7b'
---

<!doctype html>
<html lang={config.locale.lang}>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0, shrink-to-fit=no' />
    <meta name='robots' content='noindex, follow' />
    <link rel='canonical' href={canonicalHome} />
    <link rel='icon' href={config.favicon} />
    <link
      rel='preload'
      as='image'
      href='/images/home-media/thumb-1920-1381117.webp'
      fetchpriority='high'
    />
    <title>{title}</title>
    <Fragment set:html={`<script src="/theme-handoff.js" data-theme-role="read"></script>`} />
    <style is:inline>
      /* Root → Home uses the shared-color handoff, not a full-document
         screenshot dissolve. Normal pages opt in from BaseLayout. */
      @view-transition {
        navigation: none;
      }
    </style>
    {
      prod && (
        <script
          is:inline
          defer
          src={umamiScriptUrl}
          data-website-id={umamiWebsiteId}
          data-domains='susurrium.github.io'
        ></script>
      )
    }
  </head>
  <body class='min-h-[100dvh] bg-background text-foreground' data-page-kind='entrance'>
    <slot />
  </body>
</html>
