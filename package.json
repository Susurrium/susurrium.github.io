{
  "name": "susurrium.github.io",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.12.0",
    "bun": "1.4.0"
  },
  "overrides": {
    "@types/hast": "3.0.5"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:check": "astro check --watch & astro dev",
    "build": "node scripts/run-sequential.mjs build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "check:node": "node scripts/check-node-version.mjs",
    "preflight": "node scripts/run-sequential.mjs preflight",
    "verify:phase1": "bun scripts/verify-phase1.mjs",
    "verify:phase2": "bun scripts/verify-phase2.mjs",
    "verify:phase3": "bun scripts/verify-phase3.mjs",
    "verify:phase4": "bun scripts/verify-phase4.mjs",
    "verify:phase5": "bun scripts/verify-phase5.mjs",
    "verify:phase6": "bun scripts/verify-phase6.mjs",
    "verify:phase6:browser": "node scripts/verify-phase6-browser.mjs",
    "verify:browser:lifecycle": "node scripts/verify-browser-lifecycle.mjs",
    "capture:visual-baseline": "node scripts/capture-visual-baseline.mjs",
    "generate:social-card": "node scripts/generate-social-card.mjs",
    "card-crops:apply": "node scripts/apply-card-crops.mjs",
    "card-preview:generate": "bun scripts/generate-card-preview-content.ts",
    "hero-crops:apply": "node scripts/apply-hero-crops.mjs",
    "release:gate": "bun scripts/verify-phase6.mjs --strict",
    "test:all": "bun test test",
    "test:phase2": "bun test test/phase2-strategies.test.ts",
    "test:content-layer": "bun test test/content-layer.test.ts",
    "test:phase4": "bun test test/phase4-effects.test.ts",
    "test:phase5": "bun test test/phase5-specialty.test.ts",
    "check:assets": "bun scripts/check-asset-budget.mjs",
    "ci": "node scripts/run-sequential.mjs ci",
    "astro": "astro",
    "pure": "astro-pure",
    "new": "astro-pure new",
    "format": "prettier --write  '**/*.{js,jsx,ts,tsx,md,mdx,astro}'",
    "lint:check": "eslint 'src/**/*.{js,ts,jsx,tsx,astro}'",
    "lint": "eslint --fix 'src/**/*.{js,ts,jsx,tsx,astro}'",
    "yijiansilian": "bun lint && bun sync && bun check && bun format",
    "clean": "bun scripts/clean.mjs",
    "date": "tsx scripts/updateBlogDates.ts",
    "cache:avatars": "tsx scripts/cacheAvatars.ts",
    "links:check": "node scripts/check-links.mjs",
    "links:check:dry": "node scripts/check-links.mjs --dry-run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.2",
    "@waline/client": "^3.6.0",
    "astro": "6.1.8",
    "astro-pure": "1.4.6",
    "katex": "^0.16.22",
    "maplibre-gl": "5.24.0",
    "medium-zoom": "1.1.0",
    "qrcodejs": "1.0.0",
    "rehype-katex": "^7.0.1",
    "remark-github-blockquote-alert": "^1.3.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.3",
    "typed.js": "2.1.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@types/hast": "3.0.5",
    "@types/node": "24.13.3",
    "eslint": "^9.31.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "tsx": "^4.19.1",
    "typescript-eslint": "^8.37.0"
  }
}
