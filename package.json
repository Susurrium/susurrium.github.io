{
  "name": "susurrium.github.io",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.12.0",
    "bun": "1.4.0"
  },
  "overrides": {
    "@types/hast": "3.0.5"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:check": "astro check --watch & astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "check:node": "node scripts/check-node-version.mjs",
    "preflight": "bun run check:node && bun scripts/verify-preflight.mjs",
    "verify:phase1": "bun scripts/verify-phase1.mjs",
    "verify:phase2": "bun scripts/verify-phase2.mjs",
    "verify:phase3": "bun scripts/verify-phase3.mjs",
    "test:phase2": "bun test test/phase2-strategies.test.ts",
    "check:assets": "bun scripts/check-asset-budget.mjs",
    "ci": "bun run preflight && bun run lint:check && bun run build && bun run verify:phase1 && bun run test:phase2 && bun run verify:phase2 && bun run verify:phase3 && bun run check:assets",
    "astro": "astro",
    "pure": "astro-pure",
    "new": "astro-pure new",
    "format": "prettier --write  '**/*.{js,jsx,ts,tsx,md,mdx,astro}'",
    "lint:check": "eslint 'src/**/*.{js,ts,jsx,tsx,astro}'",
    "lint": "eslint --fix 'src/**/*.{js,ts,jsx,tsx,astro}'",
    "yijiansilian": "bun lint && bun sync && bun check && bun format",
    "clean": "bun scripts/clean.mjs",
    "date": "tsx scripts/updateBlogDates.ts",
    "cache:avatars": "tsx scripts/cacheAvatars.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/rss": "4.0.19",
    "@waline/client": "^3.6.0",
    "astro": "6.1.8",
    "astro-pure": "1.4.6",
    "katex": "^0.16.22",
    "medium-zoom": "1.1.0",
    "qrcodejs": "1.0.0",
    "rehype-katex": "^7.0.1",
    "remark-github-blockquote-alert": "^1.3.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.3",
    "typed.js": "2.1.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@types/hast": "3.0.5",
    "@types/node": "24.13.3",
    "eslint": "^9.31.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "tsx": "^4.19.1",
    "typescript-eslint": "^8.37.0"
  }
}
