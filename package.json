    "pagefind": "1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "tsx": "^4.23.13",
    "typescript-eslint": "8.70.0",
    "unocss": "66.10.0",
    "yaml": "2.9.0"
